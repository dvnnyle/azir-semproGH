@model azir_sempro.Models.FormViewModel
@{
    ViewData["Title"] = "Tilby ressurs";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<link rel="stylesheet" href="~/css/form.css" asp-append-version="true">

<div class="ressurs-split">
    <div class="ressurs-split__form">
        <div class="ressurs-split__header">
            <div>
                <h1>Tilby ressurs</h1>
            </div>
        </div>

        <hr class="ressurs-split__divider">

        <div class="ressurs-steg-header">
            <p class="ressurs-steg-nummer">Steg 2 av 3</p>
            <h2 class="ressurs-steg-tittel">Fyll ut detaljer</h2>
        </div>

        <form asp-controller="Form" asp-action="Beskrivelse" method="post" class="ressurs-split__fields">
            <input type="hidden" asp-for="Lokasjon">
            <input type="hidden" asp-for="PunkterJson" id="punkterJsonInput">

            <div class="ressurs-felt">
                <label asp-for="Tittel">Tittel</label>
                <input asp-for="Tittel" placeholder="Skriv ressurstittel her">
            </div>
            <div class="ressurs-felt">
                <label asp-for="Kategori">Kategori</label>
                <select asp-for="Kategori">
                    <option value="">Velg kategori...</option>
                    <option>Strøm</option>
                    <option>Medisin</option>
                    <option>Vann</option>
                    <option>Mat</option>
                    <option>Bolig</option>
                    <option>Transport</option>
                    <option>Annet</option>
                </select>
            </div>
            <div class="ressurs-felt">
                <label asp-for="Beskrivelse">Beskrivelse</label>
                <textarea asp-for="Beskrivelse" placeholder="Beskriv ressursen"></textarea>
            </div>

            <div class="ressurs-split__actions">
                <a asp-controller="Form" asp-action="Draw" class="ressurs-btn ressurs-btn--cancel">Tilbake</a>
                <button type="submit" class="ressurs-btn ressurs-btn--submit">Neste</button>
            </div>
        </form>
    </div>

    <div class="ressurs-split__map-wrap">
        <div id="map"></div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
    const tileLayer = () => L.tileLayer('https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png', { maxZoom: 18, noWrap: true });
    const senterIkon = L.divIcon({ html: '<div class="kart-senter-merke"><i class="fa-solid fa-location-crosshairs"></i></div>', className: '', iconSize: [24, 24], iconAnchor: [12, 12] });

    const punkter = JSON.parse(document.getElementById('punkterJsonInput').value || '[]').map(p => [p.lat, p.lng]);
    const erOmrade = punkter.length >= 3;
    const bounds = L.latLngBounds(punkter);
    const senter = bounds.getCenter();

    // Stort kart: viser det valgte omradet/punktet i bakgrunnen, ikke redigerbart her
    const map = L.map('map', { minZoom: 4, attributionControl: false, dragging: false, scrollWheelZoom: false }).setView(senter, 17);
    tileLayer().addTo(map);
    if (erOmrade) L.polygon(punkter, { color: '#10b981', fillColor: '#10b981', fillOpacity: 0.35 }).addTo(map);
    L.marker(senter, { icon: senterIkon }).addTo(map);
    setTimeout(() => { map.invalidateSize(); map.fitBounds(erOmrade ? bounds : bounds.pad(2), { padding: [40, 40] }); }, 50);
</script>
