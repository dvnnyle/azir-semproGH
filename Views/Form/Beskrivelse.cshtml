@model azir_sempro.Models.FormViewModel
@{
    ViewData["Title"] = "Tilby ressurs";
}
<link rel="stylesheet" href="~/lib/leaflet/dist/leaflet.min.css">
<link rel="stylesheet" href="~/css/form.css" asp-append-version="true">

<div class="ressurs-split">
    <div class="ressurs-split__form">
        <div class="ressurs-split__header">
            <h1>Tilby ressurs</h1>
        </div>

        <hr class="ressurs-split__divider">

        <div class="ressurs-steg-header">
            <p class="ressurs-steg-nummer">Steg 2 av 3</p>
            <h2 class="ressurs-steg-tittel">Fyll ut detaljer</h2>
        </div>

        <form asp-controller="Form" asp-action="Beskrivelse" method="post" class="ressurs-split__fields">
            @* Lokasjon/PunkterJson tas ikke pa nytt her - asp-for fyller dem automatisk
               med verdiene fra steg 1, siden FormController.Beskrivelse() henter utkastet
               fra TempData og sender det inn som modellen for denne siden. De sendes bare
               skjult videre i POST-en sa de ikke forsvinner nar dette steget lagres. *@
            <input type="hidden" asp-for="Lokasjon">
            <input type="hidden" asp-for="PunkterJson" id="punkterJsonInput">

            <div class="ressurs-felt">
                <label asp-for="Tittel">Tittel</label>
                <input asp-for="Tittel" placeholder="Skriv ressurstittel her">
            </div>
            <div class="ressurs-felt">
                <label asp-for="Kategori">Kategori</label>
                <select asp-for="Kategori">
                    <option value="">Velg kategori...</option>
                    <option>Strøm</option>
                    <option>Medisin</option>
                    <option>Vann</option>
                    <option>Mat</option>
                    <option>Bolig</option>
                    <option>Transport</option>
                    <option>Annet</option>
                </select>
            </div>
            <div class="ressurs-felt">
                <label asp-for="Farge">Fargekode</label>
                <select asp-for="Farge" id="fargeValg">
                    <option value="gronn" style="color:#10b981">Grønn - Tilgjengelig ressurs</option>
                    <option value="rod" style="color:#ef4444">Rød - Akutt behov</option>
                    <option value="gul" style="color:#f59e0b">Gul - Planlagt behov</option>
                    <option value="bla" style="color:#3b82f6">Blå - Offentlig aktør</option>
                </select>
            </div>
            <div class="ressurs-felt">
                <label asp-for="Beskrivelse">Beskrivelse</label>
                <textarea asp-for="Beskrivelse" placeholder="Beskriv ressursen"></textarea>
            </div>

            <div class="ressurs-split__actions">
                <a asp-controller="Form" asp-action="Draw" class="ressurs-btn ressurs-btn--cancel">Tilbake</a>
                <button type="submit" class="ressurs-btn ressurs-btn--submit">Neste</button>
            </div>
        </form>
    </div>

    <div class="ressurs-split__map-wrap">
        <div id="map"></div>
    </div>
</div>

<script src="~/lib/leaflet/dist/leaflet.min.js"></script>
<script src="~/js/ressurs-kart.js" asp-append-version="true"></script>
<script>
    /* Det finnes ikke noe "bilde" av tegningen fra steg 1 - det som faktisk folger med
       videre er bare koordinat-listen i PunkterJson (satt av FormController via TempData,
       se kommentaren ved skjul-feltene over). tegnRessursOmradeKart (wwwroot/js/ressurs-kart.js)
       leser den samme JSON-en pa nytt og tegner et helt nytt polygon/nal pa DETTE sitt eget
       kart - en frisk gjentegning, ikke det samme Leaflet-laget som i Draw.cshtml. */

    /* Fargekoden fra oppgavens kart-legende (case.md) - se samme oppslag i Oppsummering/Kvittering */
    const fargeHex = { rod: '#ef4444', gul: '#f59e0b', gronn: '#10b981', bla: '#3b82f6' };

    const punkterJson = document.getElementById('punkterJsonInput').value;
    const fargeValg = document.getElementById('fargeValg');
    let kartInstans = null;

    function tegnMedValgtFarge() {
        if (kartInstans) kartInstans.map.remove();
        kartInstans = tegnRessursOmradeKart('map', punkterJson, { farge: fargeHex[fargeValg.value] });
        /* <option>-fargen vises ikke alltid i selve den lukkede boksen (varierer per
           nettleser/OS), sa vi setter fargen pa selve <select>-en direkte i tillegg */
        fargeValg.style.color = fargeHex[fargeValg.value];
    }
    tegnMedValgtFarge();
    fargeValg.addEventListener('change', tegnMedValgtFarge);
</script>
