@model azir_sempro.Models.FormViewModel
@{
    var sideTittel = Model.Type == "behov" ? "Meld behov" : "Tilby ressurs";
    ViewData["Title"] = sideTittel;
    var kategorier = (List<azir_sempro.Models.Category>)ViewBag.Kategorier;
}
<link rel="stylesheet" href="~/lib/leaflet/dist/leaflet.min.css">
<link rel="stylesheet" href="~/css/form.css" asp-append-version="true">

<div class="ressurs-split">
    <div class="ressurs-split__form">
        <div class="ressurs-split__header">
            <h1>@sideTittel</h1>
        </div>

        <hr class="ressurs-split__divider">

        <div class="ressurs-steg-header">
            <p class="ressurs-steg-nummer">Steg 2 av 3</p>
            <h2 class="ressurs-steg-tittel">Fyll ut detaljer</h2>
        </div>

        <form asp-controller="Form" asp-action="Beskrivelse" method="post" class="ressurs-split__fields">
            <div asp-validation-summary="ModelOnly"></div>
            @* PunkterJson tas ikke pa nytt her - asp-for fyller den automatisk
               med verdien fra steg 1, siden FormController.Beskrivelse() henter utkastet
               fra TempData og sender det inn som modellen for denne siden. Den sendes bare
               skjult videre i POST-en sa den ikke forsvinner nar dette steget lagres. *@
            <input type="hidden" asp-for="PunkterJson" id="punkterJsonInput">

            <div class="ressurs-felt">
                <label asp-for="Tittel">Tittel</label>
                <input asp-for="Tittel" placeholder="Skriv ressurstittel her" required>
            </div>
            <div class="ressurs-felt">
                <label asp-for="Adresse">Adresse</label>
                <input asp-for="Adresse" placeholder="F.eks. Elvegata 12, 4610 Kristiansand" required>
            </div>
            <div class="ressurs-felt">
                <label asp-for="CategoryId">Kategori</label>
                <select asp-for="CategoryId" required>
                    <option value="">Velg kategori...</option>
                    @foreach (var kategori in kategorier)
                    {
                        <option value="@kategori.CategoryId">@kategori.Navn</option>
                    }
                </select>
            </div>
            @* Type ble valgt pa steg 1 (Draw) - bare fores skjult videre herfra *@
            <input type="hidden" asp-for="Type" id="typeInput">
            <div class="ressurs-felt" id="prioritetFelt">
                <label asp-for="Prioritet">Prioritet</label>
                <select asp-for="Prioritet" id="prioritetValg">
                    <option value="lav" style="color:#10b981">Lav</option>
                    <option value="middels" style="color:#f59e0b">Middels</option>
                    <option value="hoy" style="color:#ef4444">Høy</option>
                </select>
            </div>
            <div class="ressurs-felt">
                <label asp-for="Frist">Frist (valgfritt)</label>
                <input asp-for="Frist" type="date">
            </div>
            <div class="ressurs-felt">
                <label asp-for="Beskrivelse">Beskrivelse</label>
                <textarea asp-for="Beskrivelse" placeholder="Beskriv ressursen"></textarea>
            </div>

            <div class="ressurs-split__actions">
                <a asp-controller="Form" asp-action="Draw" class="ressurs-btn ressurs-btn--cancel">Tilbake</a>
                <button type="submit" class="ressurs-btn ressurs-btn--submit">Neste</button>
            </div>
        </form>
    </div>

    <div class="ressurs-split__map-wrap">
        <div id="map"></div>
    </div>
</div>

<script src="~/lib/leaflet/dist/leaflet.min.js"></script>
<script src="~/js/ressurs-kart.js" asp-append-version="true"></script>
<script>
    /* Det finnes ikke noe "bilde" av tegningen fra steg 1 - det som faktisk folger med
       videre er bare koordinat-listen i PunkterJson (satt av FormController via TempData,
       se kommentaren ved skjul-feltet over). tegnRessursOmradeKart (wwwroot/js/ressurs-kart.js)
       leser den samme JSON-en pa nytt og tegner et helt nytt polygon/nal pa DETTE sitt eget
       kart - en frisk gjentegning, ikke det samme Leaflet-laget som i Draw.cshtml. */

    const standardFarge = '#3388ff'; // Geoman sin standardfarge, samme som Draw.cshtml

    const punkterJson = document.getElementById('punkterJsonInput').value;
    const typeInput = document.getElementById('typeInput');
    const prioritetFelt = document.getElementById('prioritetFelt');
    let kartInstans = null;

    function tegnMedValgtFarge() {
        if (kartInstans) kartInstans.map.remove();
        kartInstans = tegnRessursOmradeKart('map', punkterJson, { farge: standardFarge });
    }

    function oppdaterPrioritetSynlighet() {
        prioritetFelt.style.display = typeInput.value === 'behov' ? '' : 'none';
    }

    oppdaterPrioritetSynlighet();
    tegnMedValgtFarge();
</script>
