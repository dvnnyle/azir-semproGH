@model azir_sempro.Models.FormViewModel
@{
    ViewData["Title"] = "Tilby ressurs";
}
<link rel="stylesheet" href="~/lib/leaflet/dist/leaflet.min.css">
<link rel="stylesheet" href="~/css/form.css" asp-append-version="true">

<div class="ressurs-split">
    <div class="ressurs-split__form">
        <div class="ressurs-split__header">
            <a asp-controller="Resources" asp-action="Index" class="ressurs-split__back"><i class="fa-solid fa-arrow-left"></i></a>
            <div>
                <h1>Tilby ressurs</h1>
            </div>
        </div>

        <hr class="ressurs-split__divider">

        <div class="ressurs-steg-header">
            <p class="ressurs-kvittering-merke"><i class="fa-solid fa-circle-check"></i> Sendt inn</p>
            <h2 class="ressurs-steg-tittel">Kvittering</h2>
            <p class="ressurs-kvittering-merke"><i class="fa-solid fa-circle-notch"></i> Status: @Model.Status</p>
        </div>

        <div class="ressurs-split__fields">
            <p class="ressurs-kvittering-tekst">Takk for at du tilbyr <strong>@Model.Tittel</strong> til beredskapen. Ressursen er registrert og synlig for andre.</p>
            <i class="fa-regular fa-face-smile ressurs-kvittering-ikon"></i>

            <div class="ressurs-split__actions">
                <a asp-controller="Form" asp-action="Draw" class="ressurs-btn ressurs-btn--submit">Tilby en til</a>
            </div>
        </div>
    </div>

    <div class="ressurs-split__map-wrap">
        <div id="map"></div>
    </div>
</div>

<script src="~/lib/leaflet/dist/leaflet.min.js"></script>
<script src="~/js/ressurs-kart.js" asp-append-version="true"></script>
<script>
    /* Dette er den egne siden som viser det innsendte skjemaet OG kartdataen
       (oppgavepunkt 4/5) - FormController.Submit() legger innsendingen i
       "innsendinger"-listen og redirecter hit, sa Model her er den samme
       FormViewModel-en som ble sendt inn, hentet tilbake fra TempData. */

    /* Her, i motsetning til Beskrivelse/Oppsummering, finnes det ikke noe skjult inputfelt a lese fra -
       PunkterJson skrives direkte inn i siden av Razor pa server-siden (@@Html.Raw skriver den
       raa JSON-teksten inn i JS-koden ufiltrert). JSON.stringify pakker den om til en vanlig
       tekststreng igjen, sa den kan sendes til tegnRessursOmradeKart pa samme mate som de andre sidene. */
    const punkterJson = JSON.stringify(@Html.Raw(string.IsNullOrWhiteSpace(Model.PunkterJson) ? "[]" : Model.PunkterJson));

    /* Fargekoden fra oppgavens kart-legende (case.md) - samme oppslag som i Beskrivelse/Oppsummering */
    const fargeHex = { rod: '#ef4444', gul: '#f59e0b', gronn: '#10b981', bla: '#3b82f6' };
    tegnRessursOmradeKart('map', punkterJson, { farge: fargeHex['@Model.Farge'] || fargeHex.gronn });

    /* Lagrer ogsa til localStorage, i tillegg til den ekte lagringen pa serveren (Punkt 2/3).
       Dette er bare en ekstra lokal cache (feks for Map-siden a lese senere) - IKKE den egentlige
       datakilden, som er "innsendinger"-listen i FormController. System.Text.Json brukes her
       (i stedet for a bygge JSON-strengen manuelt) for a unnga XSS: hvis Tittel/Beskrivelse
       inneholder anforselstegn eller en avsluttende script-tag, ville rastring-interpolasjon
       kunne odelegge eller injisere kode i denne blokken. */
    const nyRessurs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
    nyRessurs.tidspunkt = Date.now();
    const lagredeRessurser = JSON.parse(localStorage.getItem('tilbudteRessurser') || '[]');
    lagredeRessurser.push(nyRessurs);
    localStorage.setItem('tilbudteRessurser', JSON.stringify(lagredeRessurser));
</script>
