@model azir_sempro.Models.FormViewModel
@{
    ViewData["Title"] = "Tilby ressurs";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<link rel="stylesheet" href="~/css/form.css" asp-append-version="true">

<div class="ressurs-split">
    <div class="ressurs-split__form">
        <div class="ressurs-split__header">
            <a asp-controller="Home" asp-action="Index" class="ressurs-split__back" aria-label="Tilbake"><i class="fa-solid fa-arrow-left"></i></a>
            <div>
                <h1>Tilby ressurs</h1>
            </div>
        </div>

        <hr class="ressurs-split__divider">

        <div class="ressurs-steg-header">
            <p class="ressurs-kvittering-merke"><i class="fa-solid fa-circle-check"></i> Sendt inn</p>
            <h2 class="ressurs-steg-tittel">Kvittering</h2>
        </div>

        <div class="ressurs-split__fields">
            <p class="ressurs-kvittering-tekst">Takk for at du tilbyr <strong>@Model.Tittel</strong> til beredskapen. Ressursen er registrert og synlig for andre.</p>
            <i class="fa-regular fa-face-smile ressurs-kvittering-ikon"></i>

            <div class="ressurs-split__actions">
                <a asp-controller="Form" asp-action="Draw" class="ressurs-btn ressurs-btn--cancel">Tilby en til</a>
                <a asp-controller="Form" asp-action="Innsendinger" class="ressurs-btn ressurs-btn--submit">Se alle innsendinger</a>
            </div>
        </div>
    </div>

    <div class="ressurs-split__map-wrap">
        <div id="map"></div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
    const tileLayer = () => L.tileLayer('https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png', { maxZoom: 18, noWrap: true });
    const senterIkon = L.divIcon({ html: '<div class="kart-senter-merke"><i class="fa-solid fa-location-crosshairs"></i></div>', className: '', iconSize: [24, 24], iconAnchor: [12, 12] });

    const punkter = (@Html.Raw(string.IsNullOrWhiteSpace(Model.PunkterJson) ? "[]" : Model.PunkterJson)).map(p => [p.lat, p.lng]);
    const erOmrade = punkter.length >= 3;
    const bounds = L.latLngBounds(punkter);
    const senter = bounds.getCenter();

    // Stort kart i bakgrunnen: viser det innsendte omradet/punktet, ikke redigerbart her
    const map = L.map('map', { minZoom: 4, attributionControl: false, dragging: false, scrollWheelZoom: false }).setView(senter, 17);
    tileLayer().addTo(map);
    if (erOmrade) L.polygon(punkter, { color: '#10b981', fillColor: '#10b981', fillOpacity: 0.35 }).addTo(map);
    L.marker(senter, { icon: senterIkon }).addTo(map);
    setTimeout(() => { map.invalidateSize(); map.fitBounds(erOmrade ? bounds : bounds.pad(2), { padding: [40, 40] }); }, 50);

    // Lagrer ogsa til localStorage, i tillegg til den ekte lagringen pa serveren (Punkt 2/3)
    const nyRessurs = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model));
    nyRessurs.tidspunkt = Date.now();
    const lagredeRessurser = JSON.parse(localStorage.getItem('tilbudteRessurser') || '[]');
    lagredeRessurser.push(nyRessurs);
    localStorage.setItem('tilbudteRessurser', JSON.stringify(lagredeRessurser));
</script>
