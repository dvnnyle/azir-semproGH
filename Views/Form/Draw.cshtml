@model azir_sempro.Models.FormViewModel
@{
    var sideTittel = Model.Type == "behov" ? "Meld behov" : "Tilby ressurs";
    ViewData["Title"] = sideTittel;
}
<link rel="stylesheet" href="~/lib/leaflet/dist/leaflet.min.css">
<link rel="stylesheet" href="~/lib/leaflet-geoman/dist/leaflet-geoman.css">
<link rel="stylesheet" href="~/css/form.css" asp-append-version="true">

<div class="ressurs-split">
    <div class="ressurs-split__form">
        <button type="button" class="ressurs-split__fullscreen" id="fullscreenToggle" aria-label="Vis skjema i fullskjerm">
            <i class="fa-solid fa-expand"></i>
        </button>
        <div class="ressurs-split__header">
            <h1 id="sideTittel">@sideTittel</h1>
        </div>

        <hr class="ressurs-split__divider">

        <form asp-controller="Form" asp-action="Draw" method="post" class="ressurs-steg">
            <div class="ressurs-felt">
                <label>Type</label>
                <div class="type-valg">
                    <button type="button" class="type-knapp type-knapp--ressurs @(Model.Type != "behov" ? "active" : "")" data-type="ressurs">
                        <i class="fa-solid fa-hand-holding-heart"></i>
                        <span>Tilby ressurs</span>
                    </button>
                    <button type="button" class="type-knapp type-knapp--behov @(Model.Type == "behov" ? "active" : "")" data-type="behov">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <span>Meld behov</span>
                    </button>
                </div>
                <input type="hidden" asp-for="Type" id="typeInput">
            </div>

            <div class="ressurs-steg-header">
                <p class="ressurs-steg-nummer">Steg 1 av 3</p>
                <h2 class="ressurs-steg-tittel">Velg omradet</h2>
            </div>

            <input type="hidden" asp-for="PunkterJson" id="punkterJsonInput">

            <div class="ressurs-tegneverktoy">
                <button type="button" class="bar-knapp" id="minPosisjonKnapp" title="Bruk min posisjon"><i class="fa-solid fa-location-crosshairs"></i></button>
                <button type="button" class="bar-knapp modus-knapp active" id="omradeModus" title="Velg omrade"><i class="fa-solid fa-vector-square"></i></button>
                <button type="button" class="bar-knapp modus-knapp" id="pinModus" title="Slipp nal"><i class="fa-solid fa-location-dot"></i></button>
                <button type="button" class="bar-knapp modus-knapp" id="handModus" title="Flytt kart"><i class="fa-solid fa-hand"></i></button>
                <button type="button" class="bar-knapp" id="nullstillKnapp" title="Nullstill"><i class="fa-solid fa-rotate-left"></i></button>
            </div>

            <div class="mini-kart" id="lokasjonSnapshot">
                <div id="lokasjonKartForhandsvisning"></div>
                <div class="mini-kart-plassholder" id="lokasjonPlassholder">
                    <i class="fa-solid fa-camera"></i>
                    <span>Velg et omrade pa kartet</span>
                </div>
            </div>

            <div class="koordinat-boks" id="koordinatBoks">
                <div><span>Lat</span><strong id="koordinatLat">-</strong></div>
                <div><span>Lng</span><strong id="koordinatLng">-</strong></div>
            </div>

            <div class="ressurs-felt">
                <label asp-for="Adresse">Adresse</label>
                <input asp-for="Adresse" placeholder="Fylles ut nar du fullforer tegningen" required>
            </div>

            <div class="ressurs-split__actions">
                <button type="submit" class="ressurs-btn ressurs-btn--submit" id="nesteKnapp" disabled>Neste</button>
            </div>
        </form>
    </div>

    <div class="ressurs-split__map-wrap">
        <div id="map"></div>
    </div>
</div>

<script src="~/lib/leaflet/dist/leaflet.min.js"></script>
<script src="~/lib/leaflet-geoman/dist/leaflet-geoman.min.js"></script>
<script>
    /* Fullskjerm-knapp for sidepanelet (bare synlig pa mobil, se @@media
       (max-width:480px) i form.css) - veksler mellom bottom sheet og full hoyde. */
    const fullscreenToggle = document.getElementById('fullscreenToggle');
    const splitForm = document.querySelector('.ressurs-split__form');
    fullscreenToggle.addEventListener('click', () => {
        const erApen = splitForm.classList.toggle('ressurs-split__form--expanded');
        fullscreenToggle.querySelector('i').className = erApen ? 'fa-solid fa-compress' : 'fa-solid fa-expand';
    });

    /* Steg 1 av skjema-flyten: bruker tegner enten et omrade eller slipper en
       enkelt nal pa kartet. Selve tegningen gjores av Leaflet-Geoman
       (geoman.io/docs/leaflet) i stedet for handrullet mousedown/mousemove-
       handtering - Geoman legger automatisk til map.pm med enableDraw()/
       disableDraw() og et "pm:create"-event nar en tegning er ferdig.
       Resultatet lagres som JSON-punkter i det skjulte feltet PunkterJson og
       sendes videre til steg 2 (Beskrivelse). */

    const map = L.map('map', { minZoom: 4, attributionControl: false }).setView([58.1635601, 8.0031555], 17);
    const tileLayer = () => L.tileLayer('https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png', { maxZoom: 20, maxNativeZoom: 18, noWrap: true });
    tileLayer().addTo(map);

    const nalIkon = L.divIcon({ html: '<div class="marker-pin"><i class="fa-solid fa-location-dot"></i></div>', className: '', iconSize: [30, 30], iconAnchor: [15, 30] });

    const koordinatLat = document.getElementById('koordinatLat');
    const koordinatLng = document.getElementById('koordinatLng');
    function visKoordinater(latlng) {
        koordinatLat.textContent = latlng.lat.toFixed(6);
        koordinatLng.textContent = latlng.lng.toFixed(6);
    }

    const omradeButton = document.getElementById('omradeModus');
    const pinButton = document.getElementById('pinModus');
    const handButton = document.getElementById('handModus');
    const resetButton = document.getElementById('nullstillKnapp');
    const minPosisjonKnapp = document.getElementById('minPosisjonKnapp');
    const nesteKnapp = document.getElementById('nesteKnapp');
    const lokasjonPlassholder = document.getElementById('lokasjonPlassholder');
    const punkterJsonInput = document.getElementById('punkterJsonInput');
    const adresseInput = document.querySelector('[name="Adresse"]');
    const modusKnapper = [omradeButton, pinButton, handButton];

    /* Type (ressurs/behov) avgjores helt i starten av flyten na, sa resten av
       stegene (Beskrivelse/Oppsummering/Kvittering) kan vise riktig overskrift
       fra Model.Type - se samme knapp-mønster i disse. */
    const typeInput = document.getElementById('typeInput');
    const sideTittel = document.getElementById('sideTittel');
    document.querySelectorAll('.type-knapp').forEach(knapp => {
        knapp.addEventListener('click', () => {
            document.querySelectorAll('.type-knapp').forEach(k => k.classList.toggle('active', k === knapp));
            typeInput.value = knapp.dataset.type;
            sideTittel.textContent = knapp.dataset.type === 'behov' ? 'Meld behov' : 'Tilby ressurs';
        });
    });

    /* gjeldendeLag er Geoman-laget (L.Polygon eller L.Marker) fra siste
       "pm:create", gjeldendeType forteller hvilken av delene det er, siden
       Leaflet ikke har en enkel type-sjekk pa selve laget. */
    let gjeldendeLag = null;
    let gjeldendeType = null;
    let snapshotKart = null;  /* eget lite Leaflet-kart i forhandsvisningsboksen (opprettes forst ved fullforing) */
    let snapshotPolygon = null;
    let snapshotMarkor = null;

    /* Nullstiller den paagaende tegningen */
    function resetDrawing() {
        map.pm.disableDraw();
        if (gjeldendeLag) map.removeLayer(gjeldendeLag);
        gjeldendeLag = null;
        gjeldendeType = null;
        nesteKnapp.disabled = true;
        koordinatLat.textContent = '-';
        koordinatLng.textContent = '-';
        adresseInput.value = '';
    }

    /* Bytter aktivt verktoy: "omrade"/"pin" slar pa riktig Geoman-tegnemodus,
       "hand" skrur av tegning og lar deg bare panorere kartet i stedet. */
    function velgModus(knapp, nyModus) {
        map.pm.disableDraw();
        if (nyModus === 'omrade') {
            map.pm.enableDraw('Polygon', { snappable: false });
        } else if (nyModus === 'pin') {
            map.pm.enableDraw('Marker', { markerStyle: { icon: nalIkon } });
        }
        modusKnapper.forEach(k => k.classList.toggle('active', k === knapp));
    }
    omradeButton.addEventListener('click', () => velgModus(omradeButton, 'omrade'));
    pinButton.addEventListener('click', () => velgModus(pinButton, 'pin'));
    handButton.addEventListener('click', () => velgModus(handButton, 'hand'));
    resetButton.addEventListener('click', () => { resetDrawing(); omradeButton.click(); });

    /* map.locate() er innebygd i Leaflet selv (ikke Geoman) - bruker
       nettleserens navigator.geolocation internt og fyrer locationfound/
       locationerror. Flytter bare kartvisningen, tegner ikke noe selv.
       setView:false her siden Leaflets egen auto-zoom tilpasser seg
       noyaktighets-radiusen (ofte flere hundre meter pa desktop uten ekte
       GPS) - det zoomer da langt ut. Setter fast zoom selv i stedet. */
    minPosisjonKnapp.addEventListener('click', () => {
        minPosisjonKnapp.disabled = true;
        map.locate({ setView: false, maxZoom: 20, enableHighAccuracy: true });
    });
    map.on('locationfound', e => {
        minPosisjonKnapp.disabled = false;
        map.setView(e.latlng, 16);

        // Setter ogsaa en nal pa det funnet punktet og fullforer tegningen
        // automatisk, akkurat som om brukeren selv hadde sluppet en nal der
        // med pin-verktoyet og trykket "Fullfor tegning".
        map.pm.disableDraw();
        if (gjeldendeLag) map.removeLayer(gjeldendeLag);
        gjeldendeLag = L.marker(e.latlng, { icon: nalIkon }).addTo(map);
        gjeldendeType = 'Marker';
        // Ingen av verktoyene er faktisk aktive etter dette (tegningen
        // fullfores med en gang) - nullstiller highlighten sa den ikke lyver
        // om at man kan tegne med en gang uten a klikke et verktoy forst.
        modusKnapper.forEach(k => k.classList.remove('active'));
        map.dragging.enable();
        fullforTegning();
    });
    map.on('locationerror', e => {
        minPosisjonKnapp.disabled = false;
        alert('Fikk ikke tilgang til posisjonen din. (kode ' + e.code + ': ' + e.message + ')');
    });

    /* Geoman legger selv til det ferdige laget pa kartet nar en tegning
       fullfores (dobbeltklikk/klikk-pa-forste-punkt for omrade, ett klikk
       for nal) og skrur draw-modus av igjen automatisk etterpa. Tegningen
       fullfores da med en gang - ingen egen "Fullfor tegning"-knapp a trykke. */
    map.on('pm:create', event => {
        if (gjeldendeLag) map.removeLayer(gjeldendeLag);
        gjeldendeLag = event.layer;
        gjeldendeType = event.shape;
        fullforTegning();
    });

    /* Punktene fra Geoman-laget gjores her om til PunkterJson som faktisk
       sendes videre i skjemaet, og en liten forhandsvisning av omradet
       bygges i sidepanelet sa brukeren ser hva som er valgt. Kalles rett
       etter en tegning er ferdig (pm:create) eller posisjon er funnet. */
    function fullforTegning() {
        if (!gjeldendeLag) return;
        map.pm.disableDraw();
        const erOmrade = gjeldendeType !== 'Marker';
        const punkter = (erOmrade ? gjeldendeLag.getLatLngs()[0] : [gjeldendeLag.getLatLng()]).map(p => ({ lat: p.lat, lng: p.lng }));
        const bounds = L.latLngBounds(punkter.map(p => [p.lat, p.lng]));
        const senter = bounds.getCenter();

        punkterJsonInput.value = JSON.stringify(punkter);
        visKoordinater(senter);

        /* Omradet pa selve tegnekartet far sta urort med Geoman sin egen
           standardstil (blatt) - kun en nal far egen custom-ikon, siden Geoman
           sin standard nal-markor ikke passer stilen pa resten av siden. */
        if (!erOmrade) {
            map.removeLayer(gjeldendeLag);
            gjeldendeLag = L.marker(senter, { icon: nalIkon }).addTo(map);
        }

        lokasjonPlassholder.hidden = true;
        /* Mini-kartet i forhandsvisningen opprettes forst her (ikke ved siste-lasting av
           siden), fordi Leaflet ikke kan males ut i en div som fortsatt er skjult */
        if (!snapshotKart) {
            snapshotKart = L.map('lokasjonKartForhandsvisning', { zoomControl: false, dragging: false, scrollWheelZoom: false, attributionControl: false });
            tileLayer().addTo(snapshotKart);
        }
        if (snapshotPolygon) snapshotKart.removeLayer(snapshotPolygon);
        /* Geoman sin egen standardfarge (blatt) - samme som pa selve tegnekartet,
           siden Leaflet-lag ikke kan deles mellom to kart, ma den lages pa nytt her. */
        snapshotPolygon = erOmrade ? L.polygon(punkter.map(p => [p.lat, p.lng]), { color: '#3388ff', fillColor: '#3388ff', fillOpacity: 0.2 }).addTo(snapshotKart) : null;
        if (snapshotMarkor) snapshotKart.removeLayer(snapshotMarkor);
        snapshotMarkor = erOmrade ? null : L.marker(senter, { icon: nalIkon }).addTo(snapshotKart);
        setTimeout(() => {
            snapshotKart.invalidateSize();
            /* maxZoom: 17 holder forhandsvisningen pa samme zoom som selve tegnekartet over */
            snapshotKart.fitBounds(erOmrade ? bounds : bounds.pad(2), { padding: [16, 16], maxZoom: 17, animate: false });
        }, 50);

        nesteKnapp.disabled = false;

        // Slar opp adresse for senteret av det som nettopp ble tegnet,
        // i stedet for a be om ny posisjonstilgang fra nettleseren.
        fetch(`https://ws.geonorge.no/adresser/v1/punktsok?lat=${senter.lat}&lon=${senter.lng}&radius=100`)
            .then(svar => svar.json())
            .then(data => {
                const treff = data.adresser && data.adresser[0];
                if (treff) {
                    adresseInput.value = `${treff.adressetekst}, ${treff.postnummer} ${treff.poststed}`;
                }
            })
            .catch(() => {});
    }

    /* Starter i omrade-modus med en gang, siden det er det som star som aktivt i verktoylinja */
    velgModus(omradeButton, 'omrade');
</script>
