@model azir_sempro.Models.FormViewModel
@{
    ViewData["Title"] = "Tilby ressurs";
}
<link rel="stylesheet" href="~/lib/leaflet/dist/leaflet.min.css">
<link rel="stylesheet" href="~/css/form.css" asp-append-version="true">

<div class="ressurs-split">
    <div class="ressurs-split__form">
        <div class="ressurs-split__header">
            <h1>Tilby ressurs</h1>
        </div>

        <hr class="ressurs-split__divider">

        <div class="ressurs-steg-header">
            <p class="ressurs-steg-nummer">Steg 3 av 3</p>
            <h2 class="ressurs-steg-tittel">Oppsummering</h2>
        </div>

        <form asp-controller="Form" asp-action="Submit" method="post" class="ressurs-split__fields">
            <input type="hidden" asp-for="Lokasjon">
            <input type="hidden" asp-for="PunkterJson" id="punkterJsonInput">
            <input type="hidden" asp-for="Tittel">
            <input type="hidden" asp-for="Kategori">
            <input type="hidden" asp-for="Beskrivelse">

            <div class="ressurs-felt">
                <label>Lokasjon</label>
                <div class="mini-kart" id="lokasjonSnapshot">
                    <div id="lokasjonKartForhandsvisning"></div>
                </div>
            </div>

            <div class="koordinat-boks">
                <div><span>Lat</span><strong id="koordinatLat">-</strong></div>
                <div><span>Lng</span><strong id="koordinatLng">-</strong></div>
            </div>

            <div class="ressurs-felt">
                <label>Ressurstittel</label>
                <p>@Model.Tittel</p>
            </div>
            <div class="ressurs-felt">
                <label>Kategori</label>
                <p>@Model.Kategori</p>
            </div>
            <div class="ressurs-felt">
                <label>Beskrivelse</label>
                <p>@(string.IsNullOrWhiteSpace(Model.Beskrivelse) ? "Ingen beskrivelse lagt til." : Model.Beskrivelse)</p>
            </div>

            <div class="ressurs-split__actions">
                <a asp-controller="Form" asp-action="Beskrivelse" class="ressurs-btn ressurs-btn--cancel">Tilbake</a>
                <button type="submit" class="ressurs-btn ressurs-btn--submit">Bekreft og send inn</button>
            </div>
        </form>
    </div>

    <div class="ressurs-split__map-wrap">
        <div id="map"></div>
    </div>
</div>

<script src="~/lib/leaflet/dist/leaflet.min.js"></script>
<script src="~/js/ressurs-kart.js" asp-append-version="true"></script>
<script>
    /* Samme prinsipp som Beskrivelse.cshtml: PunkterJson er allerede fylt inn av
       asp-for fra utkastet i TempData - vi leser den bare ut igjen her for a
       tegne den pa nytt, ikke fordi noe nytt tegnes pa denne siden. */
    const punkterJson = document.getElementById('punkterJsonInput').value;

    /* Stort kart i bakgrunnen */
    const { senter } = tegnRessursOmradeKart('map', punkterJson);
    document.getElementById('koordinatLat').textContent = senter.lat.toFixed(6);
    document.getElementById('koordinatLng').textContent = senter.lng.toFixed(6);

    /* Mini-forhandsvisning i sidepanelet, samme snapshot-stil som steg 1 og 2 - bare mindre padding */
    tegnRessursOmradeKart('lokasjonKartForhandsvisning', punkterJson, {
        mapOptions: { zoomControl: false },
        padding: [16, 16]
    });
</script>
