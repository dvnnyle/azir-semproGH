@model azir_sempro.Models.FormViewModel
@{
    ViewData["Title"] = "Tilby ressurs";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<link rel="stylesheet" href="~/css/form.css" asp-append-version="true">

<div class="ressurs-split">
    <div class="ressurs-split__form">
        <div class="ressurs-split__header">
            <div>
                <h1>Tilby ressurs</h1>
            </div>
        </div>

        <hr class="ressurs-split__divider">

        <div class="ressurs-steg-header">
            <p class="ressurs-steg-nummer">Steg 3 av 3</p>
            <h2 class="ressurs-steg-tittel">Oppsummering</h2>
        </div>

        <form asp-controller="Form" asp-action="Submit" method="post" class="ressurs-split__fields">
            <input type="hidden" asp-for="Lokasjon">
            <input type="hidden" asp-for="PunkterJson" id="punkterJsonInput">
            <input type="hidden" asp-for="Tittel">
            <input type="hidden" asp-for="Kategori">
            <input type="hidden" asp-for="Beskrivelse">

            <div class="ressurs-felt">
                <label>Lokasjon</label>
                <div class="mini-kart" id="lokasjonSnapshot">
                    <div id="lokasjonKartForhandsvisning"></div>
                </div>
            </div>

            <div class="koordinat-boks">
                <div><span>Lat</span><strong id="koordinatLat">-</strong></div>
                <div><span>Lng</span><strong id="koordinatLng">-</strong></div>
            </div>

            <div class="ressurs-felt">
                <label>Ressurstittel</label>
                <p>@Model.Tittel</p>
            </div>
            <div class="ressurs-felt">
                <label>Kategori</label>
                <p>@Model.Kategori</p>
            </div>
            <div class="ressurs-felt">
                <label>Beskrivelse</label>
                <p>@(string.IsNullOrWhiteSpace(Model.Beskrivelse) ? "Ingen beskrivelse lagt til." : Model.Beskrivelse)</p>
            </div>

            <div class="ressurs-split__actions">
                <a asp-controller="Form" asp-action="Beskrivelse" class="ressurs-btn ressurs-btn--cancel">Tilbake</a>
                <button type="submit" class="ressurs-btn ressurs-btn--submit">Bekreft og send inn</button>
            </div>
        </form>
    </div>

    <div class="ressurs-split__map-wrap">
        <div id="map"></div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
    const tileLayer = () => L.tileLayer('https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png', { maxZoom: 18, noWrap: true });
    const senterIkon = L.divIcon({ html: '<div class="kart-senter-merke"><i class="fa-solid fa-location-crosshairs"></i></div>', className: '', iconSize: [24, 24], iconAnchor: [12, 12] });

    const punkter = JSON.parse(document.getElementById('punkterJsonInput').value || '[]').map(p => [p.lat, p.lng]);
    const erOmrade = punkter.length >= 3;
    const bounds = L.latLngBounds(punkter);
    const senter = bounds.getCenter();
    document.getElementById('koordinatLat').textContent = senter.lat.toFixed(6);
    document.getElementById('koordinatLng').textContent = senter.lng.toFixed(6);

    // Stort kart: viser det valgte omradet/punktet, ikke redigerbart her
    const map = L.map('map', { minZoom: 4, attributionControl: false, dragging: false, scrollWheelZoom: false }).setView(senter, 17);
    tileLayer().addTo(map);
    if (erOmrade) L.polygon(punkter, { color: '#10b981', fillColor: '#10b981', fillOpacity: 0.35 }).addTo(map);
    L.marker(senter, { icon: senterIkon }).addTo(map);
    setTimeout(() => { map.invalidateSize(); map.fitBounds(erOmrade ? bounds : bounds.pad(2), { padding: [40, 40] }); }, 50);

    // Mini-forhandsvisning i sidepanelet, samme snapshot-stil som steg 1 og 2
    const snapshotKart = L.map('lokasjonKartForhandsvisning', { zoomControl: false, dragging: false, scrollWheelZoom: false, attributionControl: false }).setView(senter, 17);
    tileLayer().addTo(snapshotKart);
    if (erOmrade) L.polygon(punkter, { color: '#10b981', fillColor: '#10b981', fillOpacity: 0.35 }).addTo(snapshotKart);
    L.marker(senter, { icon: senterIkon }).addTo(snapshotKart);
    setTimeout(() => { snapshotKart.invalidateSize(); snapshotKart.fitBounds(erOmrade ? bounds : bounds.pad(2), { padding: [16, 16] }); }, 50);
</script>
