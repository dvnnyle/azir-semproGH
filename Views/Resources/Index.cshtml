@model azir_sempro.Models.ResourceListViewModel
@{
    ViewData["Title"] = "Ressurser og behov";
    var harFilter = !string.IsNullOrWhiteSpace(Model.Search)
        || !string.IsNullOrWhiteSpace(Model.Category)
        || !string.IsNullOrWhiteSpace(Model.Type)
        || !string.IsNullOrWhiteSpace(Model.Status)
        || Model.FromDate.HasValue
        || Model.ToDate.HasValue;
}
<link rel="stylesheet" href="~/lib/leaflet/dist/leaflet.min.css">
<link rel="stylesheet" href="~/css/resources.css" asp-append-version="true">

<section class="resource-page">
    <header class="resource-heading">
        <div>
            <p class="resource-eyebrow">Krisis · oversikt</p>
            <h1>Ressurser og behov</h1>
            <p class="resource-intro">Se hva som tilbys og hva som trengs i berørte områder.</p>
        </div>
        <a asp-controller="Form" asp-action="Draw" class="resource-add">
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
            <span>Registrer ressurs eller behov</span>
        </a>
    </header>

    <form class="resource-filters" method="get" asp-controller="Resources" asp-action="Index">
        <label class="resource-search">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <span class="visually-hidden">Søk etter ressurs eller behov</span>
            <input type="search" name="Search" value="@Model.Search" placeholder="Søk på navn, kategori eller sted">
        </label>
        <label class="resource-filter">
            <span>Kategori</span>
            <select name="Category">
                <option value="">Alle kategorier</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category" selected="@(Model.Category == category)">@category</option>
                }
            </select>
        </label>
        <label class="resource-filter">
            <span>Type</span>
            <select name="Type">
                <option value="">Ressurser og behov</option>
                <option value="ressurs" selected="@(Model.Type == "ressurs")">Tilbys</option>
                <option value="behov" selected="@(Model.Type == "behov")">Etterspørres</option>
            </select>
        </label>
        <label class="resource-filter">
            <span>Status</span>
            <select name="Status">
                <option value="">Alle statuser</option>
                <option value="ny" selected="@(Model.Status == "ny")">Ny</option>
                <option value="vurderes" selected="@(Model.Status == "vurderes")">Vurderes</option>
                <option value="tildelt" selected="@(Model.Status == "tildelt")">Tildelt</option>
                <option value="lost" selected="@(Model.Status == "lost")">Løst</option>
            </select>
        </label>
        <label class="resource-filter resource-filter--date">
            <span>Fra dato</span>
            <input type="date" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")">
        </label>
        <label class="resource-filter resource-filter--date">
            <span>Til dato</span>
            <input type="date" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")">
        </label>
        <div class="resource-filter-actions">
            <button class="resource-filter-submit" type="submit">Filtrer</button>
            @if (harFilter)
            {
                <a class="resource-filter-clear" asp-controller="Resources" asp-action="Index">Nullstill</a>
            }
        </div>
    </form>

    <div class="resource-results-header">
        <h2>Publiserte meldinger</h2>
        <span>@Model.Submissions.Count @(Model.Submissions.Count == 1 ? "melding" : "meldinger")</span>
    </div>

    @if (Model.Submissions.Count == 0)
    {
        <div class="resource-empty">
            <span class="resource-empty__icon"><i class="fa-solid fa-map-location-dot" aria-hidden="true"></i></span>
            <h2>Ingen meldinger å vise</h2>
            <p>@(harFilter ? "Prøv å endre søket eller filtrene." : "Når noen registrerer en ressurs eller et behov, vises det her.")</p>
            @if (harFilter)
            {
                <a asp-controller="Resources" asp-action="Index" class="resource-filter-submit">Vis alle meldinger</a>
            }
        </div>
    }
    else
    {
        <div class="resource-grid">
            @foreach (var submission in Model.Submissions)
            {
                var erBehov = submission.Type == "behov";
                var typeLabel = erBehov ? "Etterspørres" : "Tilbys";
                var typeClass = erBehov ? "need" : "offer";
                // Prioritet gir bare mening for behov - ressurs er alltid "tilgjengelig"/gronn
                // (case.md sin legende: gronn = tilgjengelig ressurs).
                var priority = !erBehov ? "available" : submission.Prioritet switch
                {
                    "hoy" => "urgent",
                    "middels" => "planned",
                    _ => "available"
                };
                var priorityLabel = !erBehov ? "Tilgjengelig" : submission.Prioritet switch
                {
                    "hoy" => "Høy",
                    "middels" => "Middels",
                    _ => "Lav"
                };
                var fargeKode = priority switch
                {
                    "urgent" => "rod",
                    "planned" => "gul",
                    _ => "gronn"
                };
                var punkterJson = Model.PunkterPerSubmission.GetValueOrDefault(submission.SubmissionId, "[]");
                var kategoriNavn = Model.KategoriNavn.GetValueOrDefault(submission.CategoryId, "");
                var statusLabel = submission.Status switch
                {
                    "vurderes" => "Vurderes",
                    "tildelt" => "Tildelt",
                    "lost" => "Løst",
                    _ => "Ny"
                };
                var minutesAgo = Math.Max(0, (int)(DateTime.Now - submission.Tidspunkt).TotalMinutes);
                var submittedLabel = minutesAgo < 1
                    ? "Akkurat nå"
                    : minutesAgo < 60
                        ? $"For {minutesAgo} min siden"
                        : minutesAgo < 1440
                            ? $"For {minutesAgo / 60} t siden"
                            : $"For {minutesAgo / 1440} d siden";
                <article class="resource-card @typeClass @priority">
                    <button type="button"
                            class="resource-card__open"
                            data-resource-open
                            data-title="@submission.Tittel"
                            data-category="@kategoriNavn"
                            data-type="@typeLabel"
                            data-priority="@priorityLabel"
                            data-status="@statusLabel"
                            data-location="@submission.Adresse"
                            data-description="@submission.Beskrivelse"
                            data-submitted="@submission.Tidspunkt.ToString("dd.MM.yyyy 'kl.' HH:mm")"
                            data-points="@punkterJson"
                            data-color="@fargeKode"
                            aria-label="Vis detaljer for @submission.Tittel">
                        <span class="resource-map resource-map--preview" data-map-preview data-points="@punkterJson" data-color="@fargeKode"></span>
                        <span class="resource-card__badges">
                            <span class="resource-badge resource-badge--@typeClass">
                                <i class="fa-solid @(submission.Type == "behov" ? "fa-triangle-exclamation" : "fa-hand-holding-heart")" aria-hidden="true"></i>
                                @typeLabel
                            </span>
                            <span class="resource-badge resource-badge--priority">@priorityLabel</span>
                        </span>
                        <span class="resource-card__title">@submission.Tittel</span>
                        <span class="resource-card__category">@kategoriNavn</span>
                        <span class="resource-card__location">
                            <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                            @(string.IsNullOrWhiteSpace(submission.Adresse) ? "Sted ikke oppgitt" : submission.Adresse)
                        </span>
                        <span class="resource-card__footer">
                            <span class="resource-status"><span class="resource-status__dot"></span>@statusLabel</span>
                            <span>@submittedLabel</span>
                        </span>
                    </button>
                </article>
            }
        </div>
    }
</section>

<dialog class="resource-detail" id="resourceDetail" aria-labelledby="detailTitle">
    <div class="resource-detail__content">
        <button class="resource-detail__close" type="button" data-detail-close aria-label="Lukk detaljer">
            <i class="fa-solid fa-xmark" aria-hidden="true"></i>
        </button>
        <div class="resource-detail__map resource-map" id="detailMap" aria-label="Kart over området"></div>
        <div class="resource-detail__body">
            <div class="resource-detail__badges">
                <span class="resource-badge" id="detailType"></span>
                <span class="resource-badge resource-badge--priority" id="detailPriority"></span>
                <span class="resource-badge resource-badge--status" id="detailStatus"></span>
            </div>
            <h2 id="detailTitle"></h2>
            <dl class="resource-detail__facts">
                <div><dt>Kategori</dt><dd id="detailCategory"></dd></div>
                <div><dt>Lokasjon</dt><dd id="detailLocation"></dd></div>
                <div><dt>Meldt inn</dt><dd id="detailSubmitted"></dd></div>
            </dl>
            <div class="resource-detail__description" id="detailDescription"></div>
            <div class="resource-detail__actions">
                <button type="button" class="resource-detail__dismiss" data-detail-close>Lukk</button>
                <a class="resource-detail__map-link" id="detailMapLink" href="#" target="_blank" rel="noopener noreferrer">
                    <i class="fa-solid fa-arrow-up-right-from-square" aria-hidden="true"></i>
                    Åpne kart
                </a>
            </div>
        </div>
    </div>
</dialog>

@section Scripts {
    <script src="~/lib/leaflet/dist/leaflet.min.js"></script>
    <script src="~/js/resources.js" asp-append-version="true"></script>
}
