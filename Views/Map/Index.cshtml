@model azir_sempro.Models.ResourceListViewModel
@{ ViewData["Title"] = "Kart"; }
<link rel="stylesheet" href="~/lib/leaflet/dist/leaflet.min.css">
<link rel="stylesheet" href="~/css/form.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/map.css" asp-append-version="true">

<div class="ressurs-split">
    <div class="ressurs-split__form">
        <div class="ressurs-split__header">
            <h1>Kart</h1>
        </div>
        <hr class="ressurs-split__divider">

        <div class="kart-filter">
            <label>
                <input type="checkbox" data-filter="ressurs" checked>
                <i class="fa-solid fa-hand-holding-heart" aria-hidden="true"></i> Ressurser
            </label>
            <label>
                <input type="checkbox" data-filter="behov" checked>
                <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Behov
            </label>
            <label>
                <input type="checkbox" data-filter="nodetat" checked>
                <i class="fa-solid fa-truck-medical" aria-hidden="true"></i> Nødetater
            </label>
        </div>

            @foreach (var s in Model.Submissions)
            {
                var erBehov = s.Type == "behov";
                var fargeNavn = !erBehov ? "gronn" : s.Prioritet switch
                {
                    "høy" => "rod",
                    "middels" => "gul",
                    _ => "gronn"
                };
                var kategori = Model.KategoriNavn.GetValueOrDefault(s.CategoryId, "");
                var status = s.Status switch
                {
                    "vurderes" => "Vurderes",
                    "tildelt" => "Tildelt",
                    "lost" => "Løst",
                    _ => "Ny"
                };
                var prioritet = !erBehov ? "" : s.Prioritet switch
                {
                    "høy" => "Høy",
                    "middels" => "Middels",
                    "lav" => "Lav",
                    _ => ""
                };
                <div class="kart-listeelement"
                     data-points="@Model.PunkterPerSubmission.GetValueOrDefault(s.SubmissionId, "[]")"
                     data-color="@fargeNavn"
                     data-title="@s.Tittel"
                     data-type="@(erBehov ? "Behov" : "Ressurs")"
                     data-erbehov="@(erBehov ? "1" : "0")"
                     data-category="@kategori"
                     data-status="@status"
                     data-address="@s.Adresse"
                     data-priority="@prioritet"
                     data-publisher="@(s.IdentityUserId.HasValue ? Model.BrukerNavn.GetValueOrDefault(s.IdentityUserId.Value, "Ukjent bruker") : "Ikke oppgitt")"
                     data-id="@s.SubmissionId">
                    <span class="kart-ikon" style="background:@(erBehov ? "#f59e0b" : "#10b981")">
                        <i class="fa-solid @(erBehov ? "fa-triangle-exclamation" : "fa-hand-holding-heart")" aria-hidden="true"></i>
                    </span>
                    <div class="kart-element-tekst">
                        <strong>@s.Tittel</strong>
                        <div class="kart-kategori">@kategori</div>
                        <div class="kart-merker">
                            <span class="kart-merke"><span class="visually-hidden">Status: </span>@status</span>
                            @if (prioritet != "")
                            {
                                <span class="kart-merke kart-merke--@fargeNavn"><span class="visually-hidden">Prioritet: </span>@prioritet</span>
                            }
                        </div>
                    </div>
                </div>
            }

        <button type="button" class="kart-last-flere" id="kartLastFlere" hidden>Last inn flere</button>

        <a asp-controller="Resources" asp-action="Index" class="kart-knapp">GÅ TIL RESSURSLISTE</a>
    </div>

    <div class="ressurs-split__map-wrap">
        <div id="map"></div>
        <details class="kart-forklaring">
            <summary>
                Tegnforklaring
                <i class="fa-solid fa-chevron-up kart-forklaring__pil" aria-hidden="true"></i>
            </summary>
            <ul class="kart-forklaring__liste">
                <li><i class="fa-solid fa-location-dot kart-forklaring__nal kart-forklaring__nal--rod" aria-hidden="true"></i> Behov, høy prioritet</li>
                <li><i class="fa-solid fa-location-dot kart-forklaring__nal kart-forklaring__nal--gul" aria-hidden="true"></i> Behov, middels prioritet</li>
                <li><i class="fa-solid fa-location-dot kart-forklaring__nal kart-forklaring__nal--gronn" aria-hidden="true"></i> Ressurs, eller behov med lav prioritet</li>
                <li><i class="fa-solid fa-draw-polygon kart-forklaring__omrade" aria-hidden="true"></i> Tegnet område</li>
                <li><span class="kart-forklaring__deg" aria-hidden="true"></span> Din posisjon</li>
            </ul>
            <h3>Nødetater</h3>
            <ul class="kart-forklaring__nodetater">
                <li><i class="fa-solid fa-hospital kart-forklaring__nal kart-forklaring__nal--helse" aria-hidden="true"></i> Sykehus</li>
                <li><i class="fa-solid fa-truck-medical kart-forklaring__nal kart-forklaring__nal--helse" aria-hidden="true"></i> Ambulanse</li>
                <li><i class="fa-solid fa-building-shield kart-forklaring__nal kart-forklaring__nal--politi" aria-hidden="true"></i> Politi</li>
                <li><i class="fa-solid fa-fire-extinguisher kart-forklaring__nal kart-forklaring__nal--brann" aria-hidden="true"></i> Brann</li>
            </ul>
        </details>
    </div>
</div>

@section Scripts {
    <script src="~/lib/leaflet/dist/leaflet.min.js"></script>
    <script src="~/js/map.js" asp-append-version="true"></script>
}