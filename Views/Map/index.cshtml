@{
    ViewData["Title"] = "Kart";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<link rel="stylesheet" href="~/css/map.css" asp-append-version="true">

<div id="map"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
    const map = L.map('map', { minZoom: 4 }).setView([58.1635601, 8.0031555], 17);
    L.tileLayer('https://cache.kartverket.no/v1/wmts/1.0.0/topo/default/webmercator/{z}/{y}/{x}.png', {
        maxZoom: 18,
        noWrap: true,
        attribution: '&copy; Kartverket'
    }).addTo(map);

    // Viser omradene/nalene som er sendt inn via Tilby ressurs-skjemaet (lokalt lagret enn sa lenge)
    function ressursIkon(tittel) {
        const label = document.createElement('span');
        label.textContent = tittel || 'Tilbudt ressurs';
        return L.divIcon({ html: `<div class="report-marker"><i class="fa-solid fa-location-crosshairs"></i>${label.outerHTML}</div>`, className: '', iconSize: [150, 26], iconAnchor: [12, 12] });
    }

    const tilbudteRessurser = JSON.parse(localStorage.getItem('tilbudteRessurser') || '[]');
    tilbudteRessurser.forEach(ressurs => {
        const punkter = JSON.parse(ressurs.punkterJson || ressurs.PunkterJson || '[]').map(p => [p.lat, p.lng]);
        if (!punkter.length) return;

        const bounds = L.latLngBounds(punkter);
        if (punkter.length >= 3) {
            L.polygon(punkter, { color: '#10b981', fillColor: '#10b981', fillOpacity: 0.35 }).addTo(map);
        }
        L.marker(bounds.getCenter(), { icon: ressursIkon(ressurs.tittel || ressurs.Tittel) }).addTo(map);
    });
</script>
