@{
    ViewData["Title"] = "Velkommen";
}
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<section class="hjem-hero">
    <div class="hjem-hero__intro">
        <h1 class="hjem-hero__tittel">
            Det du har,<br>
            kan være det<br>
            <span class="hjem-aksent">noen trenger.</span>
        </h1>
        <p class="hjem-hero__tekst">
            Krisis gjør det enklere å dele ressurser i nærmiljøet. Tilby det du kan, finn det du trenger, og se hva som finnes i nærheten på kartet.
        </p>
        <div class="hjem-knapper">
            <a asp-controller="Account" asp-action="Register" class="hjem-knapp hjem-knapp--primary">
                Opprett konto
                <img src="~/assets/home/arrow-right.svg" alt="" width="18" height="18">
            </a>
            <a asp-controller="Account" asp-action="Login" class="hjem-knapp hjem-knapp--secondary">Logg inn</a>
        </div>
        <p class="hjem-hero__notis">For deg som vil bidra, og deg som leter etter noe.</p>
    </div>

    <div class="hjem-hero__visual">
        <aside class="hjem-status">
            <div class="hjem-status__header">
                <span class="hjem-status__tittel">Nylige ressurser</span>
                <a asp-controller="Resources" asp-action="Index" class="hjem-status__lenke">Gå til ressurser</a>
            </div>
            <div class="hjem-status__rad hjem-status__rad--rod">
                <span class="hjem-status__prikk"></span>
                <div class="hjem-status__info">
                    <span class="hjem-status__navn">Mangler strøm til eldresenter</span>
                    <span class="hjem-status__merke">akutt</span>
                </div>
                <span class="hjem-status__tid">12 min</span>
            </div>
            <div class="hjem-status__rad hjem-status__rad--gul">
                <span class="hjem-status__prikk"></span>
                <div class="hjem-status__info">
                    <span class="hjem-status__navn">Sandsekker mot flom</span>
                    <span class="hjem-status__merke">planlagt</span>
                </div>
                <span class="hjem-status__tid">2 t</span>
            </div>
            <div class="hjem-status__rad hjem-status__rad--gronn">
                <span class="hjem-status__prikk"></span>
                <div class="hjem-status__info">
                    <span class="hjem-status__navn">Strømaggregat til utlån</span>
                    <span class="hjem-status__merke">tilgjengelig</span>
                </div>
                <span class="hjem-status__tid">nå</span>
            </div>
        </aside>
    </div>
</section>

<div class="hjem-divider"></div>

<section class="hjem-steg-seksjon">
    <div class="hjem-sentrert">
        <div>
            <h2 class="hjem-tittel-m">Fra noe du har, til noe vi deler.</h2>
        </div>

        <div class="hjem-steg-rad">
            <div class="hjem-steg">
                <div class="hjem-steg__header">
                    <span class="hjem-steg__nummer">01</span>
                    <span class="hjem-steg__linje"></span>
                </div>
                <h3>Opprett en konto</h3>
                <p>Registrer deg for å komme i gang med å dele og finne ressurser.</p>
            </div>
            <div class="hjem-steg">
                <div class="hjem-steg__header">
                    <span class="hjem-steg__nummer">02</span>
                    <span class="hjem-steg__linje"></span>
                </div>
                <h3>Tilby eller finn en ressurs</h3>
                <p>Bruk skjemaet for å dele noe, eller utforsk ressurser i listen og på kartet.</p>
            </div>
            <div class="hjem-steg">
                <div class="hjem-steg__header">
                    <span class="hjem-steg__nummer">03</span>
                    <span class="hjem-steg__linje"></span>
                </div>
                <h3>Avtal direkte</h3>
                <p>Ta kontakt med den som deler. Avklar tilgjengelighet, bruk og henting sammen.</p>
            </div>
        </div>
    </div>
</section>

<section class="hjem-kart-seksjon">
    <div class="hjem-sentrert hjem-sentrert--rad">
        <div class="hjem-kart-seksjon__intro">
            <h2 class="hjem-tittel-m">Det du trenger,<br>kan være nærmere<br>enn du tror.</h2>
            <p class="hjem-brodtekst">
                Se hvor ressursene finnes i forhold til deg. Kartet gir en annen vei inn til det naboene dine deler.
            </p>
            <div class="hjem-veiledning">
                <img src="~/assets/home/map-pin-1.svg" width="20" height="20" alt="">
                <p>Finn et område. Se ressursen.<br>Avtal med den som deler.</p>
            </div>
            <a asp-controller="Map" asp-action="Index" class="hjem-knapp hjem-knapp--primary">
                Gå til kart
                <img src="~/assets/home/arrow-right.svg" alt="" width="18" height="18">
            </a>
        </div>

        <div class="hjem-kartkort">
            <img src="~/assets/home/map-pulse-color.gif" alt="Kartutsnitt over Kristiansand">
        </div>
    </div>
</section>

<section class="hjem-faq">
    <div class="hjem-sentrert hjem-sentrert--rad">
        <div class="hjem-faq__intro">
            <h2 class="hjem-tittel-m">Nytt her?<br>Helt naturlig å lure.</h2>
            <p class="hjem-brodtekst">Her er noen svar som gjør det enklere å komme i gang.</p>
        </div>

        <div class="hjem-faq__liste">
            <div class="hjem-faq__rad">
                <h3>Kan jeg bli med uten å ha noe å dele?</h3>
                <p>Ja. Du kan også bruke Krisis til å finne ressurser og bli kjent med det som deles i nærmiljøet.</p>
            </div>
            <div class="hjem-faq__rad">
                <h3>Er ressursene alltid tilgjengelige?</h3>
                <p>Nei. En oppføring er ikke en garanti. Avtal tilgjengelighet, vilkår og henting direkte med den som deler.</p>
            </div>
            <div class="hjem-faq__rad">
                <h3>Hva bør jeg tenke på før jeg deler?</h3>
                <p>Beskriv ressursen tydelig og del bare opplysninger du er komfortabel med. Les personverninformasjonen før du registrerer deg.</p>
            </div>
            <div class="hjem-faq__rad">
                <h3>Er Krisis en nødtjeneste?</h3>
                <p>Nei. Krisis er for ressursdeling, ikke akutt hjelp eller live beredskapsinformasjon. Ved akutt fare, ring riktig nødnummer: 110, 112 eller 113.</p>
            </div>
        </div>
    </div>
</section>

<section class="hjem-avslutning">
    <div class="hjem-invitasjon">
        <div class="hjem-invitasjon__tekst">
            <h2 class="hjem-tittel-l">Begynn med det du har.</h2>
            <p class="hjem-brodtekst">
                Bli med og gjør det enklere å dele, finne og hjelpe lokalt.<br>
                Det første steget er en konto.
            </p>
        </div>
        <div class="hjem-invitasjon__handling">
            <a asp-controller="Account" asp-action="Register" class="hjem-knapp hjem-knapp--primary">
                Opprett konto
                <img src="~/assets/home/arrow-right.svg" alt="" width="18" height="18">
            </a>
            <p class="hjem-invitasjon__logginn">
                Allerede med?
                <a asp-controller="Account" asp-action="Login">Logg inn</a>
            </p>
        </div>
    </div>
</section>
