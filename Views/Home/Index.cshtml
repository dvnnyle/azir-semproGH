@model List<azir_sempro.Models.Submission>
@{
    ViewData["Title"] = "Velkommen";
}
<link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />

<section class="hjem-hero">
    <div class="hjem-hero__intro">
        <h1 class="hjem-hero__tittel">
            <span class="hjem-aksent--behov">Meld behov,</span><br>
            eller <span class="hjem-aksent">tilby</span><br>
            <span class="hjem-aksent">ressurser.</span>
        </h1>
        <p class="hjem-hero__tekst">
            Krisis gir kriseledelsen oversikt over behov og tilgjengelige ressurser ved større hendelser som ekstremvær, strømbrudd og evakuering.
        </p>
        <div class="hjem-knapper">
            <a asp-controller="Form" asp-action="Draw" asp-route-type="behov" class="hjem-knapp hjem-knapp--behov">
                <i class="fa-solid fa-triangle-exclamation" aria-hidden="true"></i> Meld behov
            </a>
            <a asp-controller="Form" asp-action="Draw" asp-route-type="ressurs" class="hjem-knapp hjem-knapp--ressurs">
                <i class="fa-solid fa-hand-holding-heart" aria-hidden="true"></i> Tilby ressurs
            </a>
        </div>
    </div>

    <div class="hjem-hero__visual">
        <img src="~/assets/home/halo.png" alt="" class="hjem-status__halo">
        <aside class="hjem-status">
            <div class="hjem-status__header">
                <span class="hjem-status__tittel">Nylige meldinger</span>
                <a asp-controller="Resources" asp-action="Index" class="hjem-status__lenke">Se alle</a>
            </div>
            @if (!Model.Any())
            {
                <p class="hjem-status__tom">Ingen innmeldinger ennå.</p>
            }
            @foreach (var innsending in Model)
            {
                var erBehov = innsending.Type == "behov";
                var merke = !erBehov ? "Tilgjengelig" : innsending.Prioritet switch
                {
                    "høy" => "Høy",
                    "middels" => "Middels",
                    _ => "Lav"
                };
                var fargeKlasse = erBehov ? "gul" : "gronn";
                var minutterSiden = Math.Max(0, (int)(DateTime.Now - innsending.Tidspunkt).TotalMinutes);
                var tid = minutterSiden < 1 ? "nå"
                    : minutterSiden < 60 ? $"{minutterSiden} min"
                    : minutterSiden < 1440 ? $"{minutterSiden / 60} t"
                    : $"{minutterSiden / 1440} d";
                <div class="hjem-status__rad hjem-status__rad--@fargeKlasse">
                    <span class="hjem-status__ikon">
                        <i class="fa-solid @(erBehov ? "fa-triangle-exclamation" : "fa-hand-holding-heart")" aria-hidden="true"></i>
                    </span>
                    <div class="hjem-status__info">
                        <span class="hjem-status__navn">@innsending.Tittel</span>
                        <span class="hjem-status__merke">@merke</span>
                    </div>
                    <span class="hjem-status__tid">@tid</span>
                </div>
            }
        </aside>
    </div>
</section>

<div class="hjem-divider"></div>

<section class="hjem-steg-seksjon">
    <div class="hjem-sentrert">
        <div>
            <h2 class="hjem-tittel-m">Slik fungerer det</h2>
        </div>

        <div class="hjem-steg-rad">
            <div class="hjem-steg">
                <div class="hjem-steg__header">
                    <span class="hjem-steg__nummer">01</span>
                    <span class="hjem-steg__linje"></span>
                </div>
                <h3>Opprett en konto</h3>
                <p>Du må være innlogget for å registrere ressurser og behov.</p>
            </div>
            <div class="hjem-steg">
                <div class="hjem-steg__header">
                    <span class="hjem-steg__nummer">02</span>
                    <span class="hjem-steg__linje"></span>
                </div>
                <h3>Registrer det som trengs eller finnes</h3>
                <p>Oppgi type, område og frist. For eksempel kjøretøy, maskiner, aggregater, samband eller mannskap.</p>
            </div>
            <div class="hjem-steg">
                <div class="hjem-steg__header">
                    <span class="hjem-steg__nummer">03</span>
                    <span class="hjem-steg__linje"></span>
                </div>
                <h3>Behov og ressurs kobles</h3>
                <p>Kriseledelsen vurderer meldingene og kobler behov med tilgjengelige ressurser.</p>
            </div>
        </div>
    </div>
</section>

<section class="hjem-kart-seksjon">
    <div class="hjem-sentrert hjem-sentrert--rad">
        <div class="hjem-kart-seksjon__intro">
            <h2 class="hjem-tittel-m">Se behov og<br>ressurser på<br>kartet.</h2>
            <p class="hjem-brodtekst">
                Kartet viser registrerte behov, tilgjengelige ressurser og nødetater i området.
            </p>
            <div class="hjem-veiledning">
                <img src="~/assets/home/map-pin-1.svg" width="20" height="20" alt="">
                <p>Finn et område. Se hva som trengs,<br>og hva som er tilgjengelig.</p>
            </div>
            <a asp-controller="Map" asp-action="Index" class="hjem-knapp hjem-knapp--primary">
                Gå til kart
                <img src="~/assets/home/arrow-right.svg" alt="" width="18" height="18">
            </a>
        </div>

        <div class="hjem-kartkort">
            <img src="~/assets/home/map-pulse-color.gif" alt="Kartutsnitt over Kristiansand">
        </div>
    </div>
</section>

<section class="hjem-faq">
    <div class="hjem-sentrert hjem-sentrert--rad">
        <div class="hjem-faq__intro">
            <h2 class="hjem-tittel-m">Spørsmål<br>og svar</h2>
            <p class="hjem-brodtekst">Det viktigste å vite før du registrerer noe.</p>
        </div>

        <div class="hjem-faq__liste">
            <div class="hjem-faq__rad">
                <h3>Hvilke ressurser er relevante?</h3>
                <p>Ressurser som kan brukes i en krise, som kjøretøy, maskiner, droner, aggregater, samband, drivstoff, sand og grus eller mannskap.</p>
            </div>
            <div class="hjem-faq__rad">
                <h3>Er ressursene alltid tilgjengelige?</h3>
                <p>Nei. En registrert ressurs er ingen garanti. Tilgjengelighet må bekreftes med den som har registrert den.</p>
            </div>
            <div class="hjem-faq__rad">
                <h3>Hva må jeg oppgi?</h3>
                <p>Beskriv behovet eller ressursen presist, med område og eventuell frist. Oppgi bare opplysninger som er nødvendige.</p>
            </div>
            <div class="hjem-faq__rad">
                <h3>Er Krisis en nødtjeneste?</h3>
                <p>Nei. Krisis gir oversikt over behov og ressurser, ikke akutt hjelp. Ved akutt fare, ring riktig nødnummer: 110, 112 eller 113.</p>
            </div>
        </div>
    </div>
</section>

<section class="hjem-avslutning">
    <div class="hjem-invitasjon">
        <div class="hjem-invitasjon__tekst">
            <h2 class="hjem-tittel-l">Har du ressurser som kan brukes i en krise?</h2>
            <p class="hjem-brodtekst">
                Registrer dem nå, så kriseledelsen vet hva som finnes.<br>
                Det første steget er en konto.
            </p>
        </div>
        <div class="hjem-invitasjon__handling">
            <a asp-controller="Account" asp-action="Register" class="hjem-knapp hjem-knapp--primary">
                Opprett konto
                <img src="~/assets/home/arrow-right.svg" alt="" width="18" height="18">
            </a>
            <p class="hjem-invitasjon__logginn">
                Allerede med?
                <a asp-controller="Account" asp-action="Login">Logg inn</a>
            </p>
        </div>
    </div>
</section>
