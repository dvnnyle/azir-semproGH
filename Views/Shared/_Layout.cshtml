@{
    var navController = ViewContext.RouteData.Values["controller"]?.ToString();
    var navAction = ViewContext.RouteData.Values["action"]?.ToString();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - azir_sempro</title>
    <link rel="icon" type="image/svg+xml" href="~/assets/icons/logoGreen.svg">
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@400;700;800&family=Poppins:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/azir-sempro.styles.css" asp-append-version="true" />
</head>
<body class="@(navController == "Map" ? "no-footer" : "")">
    <nav class="nav-bar">
        <div class="brand">
            <img src="~/assets/icons/logoGreen.svg" alt="" class="brand-logo">
            <div class="brand-text">
                <div class="brand-name">azir</div>
                <div class="brand-subtitle">semesterproject</div>
            </div>
        </div>
        <div class="nav-links">
            <a asp-controller="Home" asp-action="Index" class="nav-item @(navController == "Home" && navAction == "Index" ? "active" : "")">
                <div class="nav-item-label">Home</div>
                <div class="active-indicator"></div>
            </a>
            <a asp-controller="Form" asp-action="Index" class="nav-item @(navController == "Form" ? "active" : "")">
                <div class="nav-item-label">Form</div>
                <div class="active-indicator"></div>
            </a>
            <a asp-controller="Resources" asp-action="Index" class="nav-item @(navController == "Resources" ? "active" : "")">
                <div class="nav-item-label">Resources</div>
                <div class="active-indicator"></div>
            </a>
            <a asp-controller="Map" asp-action="Index" class="nav-item @(navController == "Map" ? "active" : "")">
                <div class="nav-item-label">Map</div>
                <div class="active-indicator"></div>
            </a>
        </div>
        <div class="nav-account">
            <button type="button" class="nav-avatar" id="navAccountToggle" aria-label="Account" aria-expanded="false">
                <i class="fa-solid fa-user"></i>
            </button>
            <div class="konto-dropdown" id="navAccountDropdown">
                <a asp-controller="Account" asp-action="Login" class="konto-dropdown__pill konto-dropdown__pill--primary">Log in</a>
                <a asp-controller="Account" asp-action="Register" class="konto-dropdown__pill konto-dropdown__pill--secondary">Sign up</a>
            </div>
        </div>
    </nav>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (navController != "Map")
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - azir_sempro
            </div>
        </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        const navAccountToggle = document.getElementById('navAccountToggle');
        const navAccountDropdown = document.getElementById('navAccountDropdown');

        navAccountToggle.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpen = navAccountDropdown.classList.toggle('open');
            navAccountToggle.setAttribute('aria-expanded', isOpen);
        });

        document.addEventListener('click', (e) => {
            if (!navAccountDropdown.contains(e.target) && !navAccountToggle.contains(e.target)) {
                navAccountDropdown.classList.remove('open');
                navAccountToggle.setAttribute('aria-expanded', false);
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
