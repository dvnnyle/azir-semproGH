@model azir_sempro.Models.AdminResourceOverviewViewModel
@{
    ViewData["Title"] = "Oversikt";
    var statusLabels = new Dictionary<string, string>
    {
        ["ny"] = "Ny",
        ["vurderes"] = "Vurderes",
        ["tildelt"] = "Tildelt",
        ["lost"] = "Løst"
    };
}
<link rel="stylesheet" href="~/css/admin.css" asp-append-version="true">

<section class="admin-page">
    <header class="admin-heading">
        <div>
            <h1>Oversikt</h1>
            <p>Alle behov og ressurser fra brukere og organisasjoner.</p>
        </div>
        <div class="admin-stats" aria-label="Oversikt over meldinger">
            <span><strong>@Model.TotalCount</strong> totalt</span>
            <span><strong>@Model.ResourceCount</strong> ressurser</span>
            <span><strong>@Model.NeedCount</strong> behov</span>
            <span><strong>@Model.NewCount</strong> nye</span>
        </div>
    </header>

    @if (TempData["AdminMessage"] is string message)
    {
        <div class="admin-notice" role="status">@message</div>
    }

    <form class="admin-filters" method="get" asp-controller="Admin" asp-action="Index">
        <label class="admin-search">
            <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
            <span class="visually-hidden">Søk etter tittel, sted eller eier</span>
            <input type="search" name="Search" value="@Model.Search" placeholder="Søk etter tittel, sted eller eier">
        </label>
        <label class="admin-filter">
            <span>Kommune</span>
            <select name="Kommune">
                <option value="">Alle kommuner</option>
                @foreach (var kommune in Model.Kommuner)
                {
                    <option value="@kommune" selected="@(Model.Kommune == kommune)">@kommune</option>
                }
            </select>
        </label>
        <label class="admin-filter">
            <span>Kategori</span>
            <select name="Category">
                <option value="">Alle kategorier</option>
                @foreach (var category in Model.Categories)
                {
                    <option value="@category" selected="@(Model.Category == category)">@category</option>
                }
            </select>
        </label>
        <label class="admin-filter">
            <span>Type</span>
            <select name="Type">
                <option value="">Alle typer</option>
                <option value="ressurs" selected="@(Model.Type == "ressurs")">Ressurser</option>
                <option value="behov" selected="@(Model.Type == "behov")">Behov</option>
            </select>
        </label>
        <label class="admin-filter">
            <span>Status</span>
            <select name="Status">
                <option value="">Alle statuser</option>
                <option value="ny" selected="@(Model.Status == "ny")">Ny</option>
                <option value="vurderes" selected="@(Model.Status == "vurderes")">Vurderes</option>
                <option value="tildelt" selected="@(Model.Status == "tildelt")">Tildelt</option>
                <option value="lost" selected="@(Model.Status == "lost")">Løst</option>
            </select>
        </label>
        <button type="submit" class="admin-filter-submit">Filtrer</button>
        @* Sender filteret med, slik at utskriften alltid følger det som er valgt. Se admin.js. *@
        <button type="submit" name="skrivut" value="1" class="admin-filter-submit">Skriv ut</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Kommune) ||!string.IsNullOrWhiteSpace(Model.Category) || !string.IsNullOrWhiteSpace(Model.Type) || !string.IsNullOrWhiteSpace(Model.Status))
        {
            <a class="admin-filter-clear" asp-controller="Admin" asp-action="Index">Nullstill</a>
        }
    </form>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th scope="col">Tittel</th>
                    <th scope="col">Type</th>
                    <th scope="col">Status</th>
                    <th scope="col">Publisert av</th>
                    <th scope="col">Meldt inn</th>
                    <th scope="col"><span class="visually-hidden">Handlinger</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var submission in Model.Submissions)
                {
                    <tr>
                        <td data-label="Tittel">
                            <span class="admin-title">@submission.Tittel</span>
                            <span class="admin-subtitle" title="Kategori">
                                <i class="fa-solid fa-tag" aria-hidden="true"></i><span class="visually-hidden">Kategori: </span>@submission.CategoryName
                            </span>
                            @if (!string.IsNullOrWhiteSpace(submission.Kommune))
                            {
                                <span class="admin-subtitle" title="Kommune">
                                    <i class="fa-solid fa-map" aria-hidden="true"></i><span class="visually-hidden">Kommune: </span>@submission.Kommune
                                </span>
                            }
                            <span class="admin-subtitle" title="Adresse">
                                <i class="fa-solid fa-location-dot" aria-hidden="true"></i><span class="visually-hidden">Adresse: </span>@submission.Adresse
                            </span>
                        </td>
                        @{
                            var erBehov = submission.Type == "behov";
                            var prioritet = submission.Prioritet switch
                            {
                                "høy" => "Høy",
                                "middels" => "Middels",
                                "lav" => "Lav",
                                _ => null
                            };
                        }
                        <td data-label="Type">
                            <span class="admin-type">
                                <span class="admin-type-ikon admin-type-ikon--@(erBehov ? "behov" : "ressurs")">
                                    <i class="fa-solid @(erBehov ? "fa-triangle-exclamation" : "fa-hand-holding-heart")" aria-hidden="true"></i>
                                </span>
                                @(erBehov ? (prioritet is null ? "Behov" : $"Behov · {prioritet}") : "Ressurs")
                            </span>
                        </td>
                        <td data-label="Status">
                            <span class="admin-status admin-status--@submission.Status">
                                <span aria-hidden="true"></span>@statusLabels.GetValueOrDefault(submission.Status, submission.Status)
                            </span>
                        </td>
                        <td data-label="Publisert av">@submission.OwnerName</td>
                        <td data-label="Meldt inn" class="admin-date">@submission.Tidspunkt.ToString("dd. MMM yyyy")</td>
                        <td data-label="Handlinger" class="admin-actions">
                            <a asp-controller="Resources" asp-action="Index" asp-route-apne="@submission.SubmissionId"
                               class="admin-action" aria-label="Åpne @submission.Tittel" title="Åpne">
                                <i class="fa-solid fa-up-right-from-square" aria-hidden="true"></i>
                            </a>
                            <a asp-controller="Admin" asp-action="Edit" asp-route-id="@submission.SubmissionId"
                               class="admin-action" aria-label="Rediger @submission.Tittel" title="Rediger">
                                <i class="fa-solid fa-pen" aria-hidden="true"></i>
                            </a>
                            <form asp-controller="Admin" asp-action="Delete" asp-route-id="@submission.SubmissionId"
                                  method="post" data-confirm-delete="Er du sikker på at du vil slette denne meldingen?">
                                <button type="submit" class="admin-action admin-action--delete"
                                        aria-label="Slett @submission.Tittel" title="Slett">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @if (Model.Submissions.Count == 0)
        {
            <div class="admin-empty">Ingen meldinger samsvarer med søket.</div>
        }
        else
        {
            <p class="admin-table-count">Viser @Model.Submissions.Count av @Model.TotalCount meldinger</p>
        }
    </div>

    @* Rapporten vises bare på papir. Skjermsiden over skjules ved utskrift, se admin.css. *@
    @{
        var rapportNavn = Model.Type switch
        {
            "ressurs" => "Ressursliste",
            "behov" => "Behovsliste",
            _ => "Ressurser og behov"
        };
        var alleKommuner = string.IsNullOrWhiteSpace(Model.Kommune);
        var antallTekst = Model.Submissions.Count == 1 ? "1 melding" : $"{Model.Submissions.Count} meldinger";
    }
    <section class="admin-rapport">
        <div class="admin-rapport-topp">
            <span class="admin-rapport-merke">Krisis</span>
            <span>Utskrevet @DateTime.Now.ToString("dd.MM.yyyy 'kl.' HH:mm")</span>
        </div>
        <h2>@rapportNavn</h2>
        <p class="admin-rapport-meta">
            <strong>@(alleKommuner ? "Alle kommuner" : $"{Model.Kommune} kommune")</strong> · @antallTekst
            @if (!string.IsNullOrWhiteSpace(Model.Category))
            {
                <text> · Kategori: @Model.Category</text>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Status))
            {
                <text> · Status: @statusLabels.GetValueOrDefault(Model.Status, Model.Status)</text>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Search))
            {
                <text> · Søk: @Model.Search</text>
            }
        </p>

        @if (Model.Submissions.Count == 0)
        {
            <p>Ingen meldinger samsvarer med valgt filter.</p>
        }
        else
        {
            <table>
                <colgroup>
                    <col class="admin-rapport-kol-melding">
                    <col class="admin-rapport-kol-sted">
                    <col class="admin-rapport-kol-status">
                    <col class="admin-rapport-kol-kontakt">
                    <col class="admin-rapport-kol-dato">
                </colgroup>
                <thead>
                    <tr>
                        <th scope="col">Melding</th>
                        <th scope="col">Sted</th>
                        <th scope="col">Status</th>
                        <th scope="col">Kontakt</th>
                        <th scope="col">Dato</th>
                    </tr>
                </thead>
                @foreach (var gruppe in Model.Submissions.GroupBy(submission => submission.CategoryName).OrderBy(gruppe => gruppe.Key))
                {
                    <tbody>
                        <tr class="admin-rapport-gruppe">
                            <th colspan="5" scope="colgroup">@gruppe.Key (@gruppe.Count())</th>
                        </tr>
                        @foreach (var submission in gruppe)
                        {
                            <tr>
                                <td>
                                    <strong>@submission.Tittel</strong>
                                    @if (submission.Type == "behov")
                                    {
                                        <span class="admin-rapport-liten">Behov@(submission.Prioritet is null ? "" : $", {submission.Prioritet} prioritet")</span>
                                    }
                                    else if (string.IsNullOrWhiteSpace(Model.Type))
                                    {
                                        <span class="admin-rapport-liten">Ressurs</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(submission.Beskrivelse))
                                    {
                                        <span class="admin-rapport-tekst">@submission.Beskrivelse</span>
                                    }
                                </td>
                                <td>
                                    @submission.Adresse
                                    @if (alleKommuner && !string.IsNullOrWhiteSpace(submission.Kommune))
                                    {
                                        <span class="admin-rapport-liten">@submission.Kommune kommune</span>
                                    }
                                </td>
                                <td>@statusLabels.GetValueOrDefault(submission.Status, submission.Status)</td>
                                <td>
                                    @submission.OwnerName
                                    @if (!string.IsNullOrWhiteSpace(submission.OwnerPhone))
                                    {
                                        <span class="admin-rapport-liten">@submission.OwnerPhone</span>
                                    }
                                </td>
                                <td class="admin-rapport-dato">
                                    @submission.Tidspunkt.ToString("dd.MM.yyyy")
                                    @if (submission.Frist.HasValue)
                                    {
                                        <span class="admin-rapport-liten">Frist @submission.Frist.Value.ToString("dd.MM.yyyy")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                }
            </table>
        }
    </section>
</section>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
}
