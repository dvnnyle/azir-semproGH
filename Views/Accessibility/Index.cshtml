@{
    ViewData["Title"] = "Tilgjengelighet";
    var valg = new[]
    {
        (Id: "hoy-kontrast", Ikon: "fa-circle-half-stroke", Tittel: "Høy kontrast", Tekst: "Hvit tekst på svart bakgrunn og tydelige kanter"),
        (Id: "storre-tekst", Ikon: "fa-text-height", Tittel: "Større tekst", Tekst: "Gjør tekst og knapper større"),
        (Id: "lettlest-skrift", Ikon: "fa-font", Tittel: "Lettlest skrift", Tekst: "Enkel skrifttype med mer luft mellom ordene"),
        (Id: "understrek", Ikon: "fa-underline", Tittel: "Understrek lenker", Tekst: "Lenker kjennes igjen uten å se forskjell på farger"),
        (Id: "fokus", Ikon: "fa-expand", Tittel: "Tydelig fokusmarkering", Tekst: "Ser hvor du er ved tastaturnavigasjon"),
        (Id: "redusert-bevegelse", Ikon: "fa-person-walking", Tittel: "Redusert bevegelse", Tekst: "Skrur av animasjoner og overganger")
    };
}
<link rel="stylesheet" href="~/css/account.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/accessibility.css" asp-append-version="true">

<div class="page-fill konto-wrap">
    <div class="kort tilgjengelighet-kort">
        <div class="konto-header">
            <div class="avatar-sirkel"><i class="fa-solid fa-universal-access" aria-hidden="true"></i></div>
            <div class="tittel-blokk">
                <h1>Tilgjengelighet</h1>
                <p>Tilpass hvordan Krisis vises for deg. Valgene lagres i denne nettleseren.</p>
            </div>
        </div>

        <div class="tilgjengelighet-seksjon">
            <h2 class="tilgjengelighet-gruppe-tittel">Visning</h2>
            <div class="tilgjengelighet-grid">
                @foreach (var v in valg)
                {
                    <label class="tilgjengelighet-rad">
                        <span class="tilgjengelighet-ikon"><i class="fa-solid @v.Ikon" aria-hidden="true"></i></span>
                        <span class="tilgjengelighet-tekst">
                            <strong>@v.Tittel</strong>
                            <span class="tilgjengelighet-forklaring">@v.Tekst</span>
                        </span>
                        <input type="checkbox" role="switch" class="bryter-input" data-a11y="@v.Id">
                        <span class="bryter" aria-hidden="true"></span>
                    </label>
                }
            </div>
        </div>
    </div>
</div>
