@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Nytt passord";
    var done = ViewData["Done"] is true;
}
<link rel="stylesheet" href="~/css/account.css" asp-append-version="true">

<div class="page-fill konto-wrap">
    <div class="kort">
        <div class="konto-header">
            <div class="avatar-sirkel"><i class="fa-solid fa-key"></i></div>
            <div class="tittel-blokk">
                <h1>Nytt passord</h1>
                <p>@(done ? "Passordet er endret. Du kan nå logge inn." : "Velg et nytt passord for kontoen din.")</p>
            </div>
        </div>

        @if (done)
        {
            <a asp-controller="Account" asp-action="Login" class="konto-knapp" style="text-align:center;text-decoration:none;">Logg inn</a>
        }
        else
        {
            <form class="inputs-stack" method="post" asp-controller="Account" asp-action="ResetPassword">
                <div asp-validation-summary="ModelOnly"></div>
                <input type="hidden" asp-for="Email">
                <input type="hidden" asp-for="Code">

                <div class="felt-gruppe">
                    <label class="konto-label" asp-for="Password">Nytt passord</label>
                    <input type="password" asp-for="Password" class="konto-input" placeholder="Min. 8 tegn" minlength="8" autocomplete="new-password" required>
                    <span asp-validation-for="Password"></span>
                </div>

                <div class="felt-gruppe">
                    <label class="konto-label" asp-for="ConfirmPassword">Gjenta passord</label>
                    <input type="password" asp-for="ConfirmPassword" class="konto-input" autocomplete="new-password" required>
                    <span asp-validation-for="ConfirmPassword"></span>
                </div>

                <button type="submit" class="konto-knapp">Lagre nytt passord</button>
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
