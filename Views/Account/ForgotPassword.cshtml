@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Glemt passord";
    var sent = ViewData["Sent"] is true;
}
<link rel="stylesheet" href="~/css/account.css" asp-append-version="true">

<div class="page-fill konto-wrap">
    <div class="kort">
        <div class="konto-header">
            <div class="avatar-sirkel"><i class="fa-solid fa-key"></i></div>
            <div class="tittel-blokk">
                <h1>Glemt passord</h1>
                <p>Skriv inn e-posten din, så får du en lenke for å lage et nytt passord.</p>
            </div>
        </div>

        @if (sent)
        {
            <p role="status">Hvis e-posten er registrert hos oss, er det sendt en lenke for å tilbakestille passordet.</p>
        }
        else
        {
            <form class="inputs-stack" method="post" asp-controller="Account" asp-action="ForgotPassword">
                <div asp-validation-summary="ModelOnly"></div>
                <div class="felt-gruppe">
                    <label class="konto-label" asp-for="Email">E-post</label>
                    <input type="email" asp-for="Email" class="konto-input" placeholder="navn@eksempel.no" autocomplete="email" required>
                    <span asp-validation-for="Email"></span>
                </div>

                <button type="submit" class="konto-knapp">Send lenke</button>
            </form>
        }

        <div class="bytte-row">
            Husker du passordet? <a asp-controller="Account" asp-action="Login">Logg inn</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
