@model azir_sempro.Models.ApplicationUser
@{
    ViewData["Title"] = "Innstillinger";
    var navn = $"{Model.FirstName} {Model.LastName}".Trim();
}
<link rel="stylesheet" href="~/css/account.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/accessibility.css" asp-append-version="true">

<div class="page-fill konto-wrap">
    <div class="kort tilgjengelighet-kort">
        <div class="konto-header">
            <div class="avatar-sirkel"><i class="fa-solid fa-gear" aria-hidden="true"></i></div>
            <div class="tittel-blokk">
                <h1>Innstillinger</h1>
                <p>Kontoen din og hvordan Krisis vises for deg</p>
            </div>
        </div>

        <div class="tilgjengelighet-seksjon">
            <h2 class="tilgjengelighet-gruppe-tittel">Kontodetaljer</h2>
            <dl class="innstillinger-detaljer">
                <div>
                    <dt><i class="fa-solid fa-user" aria-hidden="true"></i> Navn</dt>
                    <dd>@navn</dd>
                </div>
                <div>
                    <dt><i class="fa-solid fa-envelope" aria-hidden="true"></i> E-post</dt>
                    <dd>@Model.Email</dd>
                </div>
                <div>
                    <dt><i class="fa-solid fa-phone" aria-hidden="true"></i> Telefon</dt>
                    <dd>@Model.PhoneNumber</dd>
                </div>
                <div>
                    <dt><i class="fa-solid fa-shield-halved" aria-hidden="true"></i> Rolle</dt>
                    <dd>@ViewBag.Roller</dd>
                </div>
            </dl>
        </div>

        <div class="tilgjengelighet-seksjon">
            <h2 class="tilgjengelighet-gruppe-tittel">Snarveier</h2>
            <div class="tilgjengelighet-grid">
                <a asp-controller="Account" asp-action="Profile" class="tilgjengelighet-rad">
                    <span class="tilgjengelighet-ikon"><i class="fa-solid fa-user-gear" aria-hidden="true"></i></span>
                    <div class="tilgjengelighet-tekst">
                        <strong>Min side</strong>
                        <p>Dine ressurser og behov</p>
                    </div>
                    <i class="fa-solid fa-chevron-right tilgjengelighet-pil" aria-hidden="true"></i>
                </a>
                <a asp-controller="Accessibility" asp-action="Index" class="tilgjengelighet-rad">
                    <span class="tilgjengelighet-ikon"><i class="fa-solid fa-universal-access" aria-hidden="true"></i></span>
                    <div class="tilgjengelighet-tekst">
                        <strong>Tilgjengelighet</strong>
                        <p>Kontrast, tekststørrelse og mer</p>
                    </div>
                    <i class="fa-solid fa-chevron-right tilgjengelighet-pil" aria-hidden="true"></i>
                </a>
            </div>
        </div>

        <div class="tilgjengelighet-seksjon">
            <h2 class="tilgjengelighet-gruppe-tittel">Sikkerhet</h2>
            <div class="tilgjengelighet-grid">
                <a asp-controller="Account" asp-action="ForgotPassword" class="tilgjengelighet-rad">
                    <span class="tilgjengelighet-ikon"><i class="fa-solid fa-key" aria-hidden="true"></i></span>
                    <div class="tilgjengelighet-tekst">
                        <strong>Bytt passord</strong>
                        <p>Få lenke til nytt passord</p>
                    </div>
                    <i class="fa-solid fa-chevron-right tilgjengelighet-pil" aria-hidden="true"></i>
                </a>
                <a asp-controller="Account" asp-action="DeleteAccount" class="tilgjengelighet-rad">
                    <span class="tilgjengelighet-ikon tilgjengelighet-ikon--fare"><i class="fa-solid fa-trash" aria-hidden="true"></i></span>
                    <div class="tilgjengelighet-tekst">
                        <strong>Slett konto</strong>
                        <p>Fjerner konto og data</p>
                    </div>
                    <i class="fa-solid fa-chevron-right tilgjengelighet-pil" aria-hidden="true"></i>
                </a>
            </div>
        </div>
    </div>
</div>
