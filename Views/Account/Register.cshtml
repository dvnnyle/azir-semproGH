@model AccountViewModel
@{
    ViewData["Title"] = "Registrer deg";
}
<link rel="stylesheet" href="~/css/account.css" asp-append-version="true">

<div class="page-fill konto-wrap">
    <div class="kort">
        <div class="konto-header">
            <div class="avatar-sirkel"><i class="fa-solid fa-user"></i></div>
            <div class="tittel-blokk">
                <h1>Registrer deg</h1>
                <p>Opprett en konto for å komme i gang</p>
            </div>
        </div>

        <form class="inputs-stack" method="post" asp-controller="Account" asp-action="Register">
            <div asp-validation-summary="ModelOnly"></div>

            <div class="felt-gruppe">
                <label class="konto-label" asp-for="FirstName">Fornavn</label>
                <input type="text" asp-for="FirstName" class="konto-input" placeholder="Ola" required>
            </div>

            <div class="felt-gruppe">
                <label class="konto-label" asp-for="LastName">Etternavn</label>
                <input type="text" asp-for="LastName" class="konto-input" placeholder="Nordmann" required>
            </div>

            <div class="felt-gruppe">
                <label class="konto-label" asp-for="Email">E-post</label>
                <input type="email" asp-for="Email" class="konto-input" placeholder="navn@eksempel.no" required>
                <span asp-validation-for="Email"></span>
            </div>

            <div class="felt-gruppe">
                <label class="konto-label" asp-for="PhoneNumber">Telefonnummer</label>
                <input type="tel" asp-for="PhoneNumber" class="konto-input" placeholder="+47 12345678" required>
                <span asp-validation-for="PhoneNumber"></span>
            </div>

            <div class="felt-gruppe">
                <label class="konto-label" asp-for="Password">Passord</label>
                <input type="password" asp-for="Password" class="konto-input" placeholder="Min. 8 tegn" minlength="8" required>
            </div>

            <button type="submit" class="konto-knapp">Registrer deg</button>
        </form>

        <div class="bytte-row">
            Har du allerede en konto? <a asp-controller="Account" asp-action="Login">Logg inn</a>
        </div>
    </div>
</div>
