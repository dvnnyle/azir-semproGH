@model azir_sempro.Models.ProfileSubmissionEditViewModel
@{
    ViewData["Title"] = "Rediger melding";
    var categories = ViewBag.Categories as List<azir_sempro.Models.Category> ?? [];
}
<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true">

<section class="profile-page profile-edit-page">
    <a asp-controller="Account" asp-action="Profile" class="profile-back">
        <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Tilbake til profilen
    </a>
    <header class="profile-heading">
        <div>
            <p class="profile-eyebrow">Krisis · mine meldinger</p>
            <h1>Rediger melding</h1>
            <p>Oppdater detaljene. Typen og kartområdet beholdes uendret.</p>
        </div>
    </header>

    <form asp-controller="Account" asp-action="EditSubmission" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post" class="profile-edit-form">
        <div asp-validation-summary="ModelOnly" class="profile-validation" role="alert"></div>
        <p class="profile-edit-type">Type <strong>@(Model.Type == "behov" ? "Behov" : "Ressurs")</strong></p>
        <label>
            <span>Tittel</span>
            <input asp-for="Tittel" autocomplete="off">
            <span asp-validation-for="Tittel"></span>
        </label>
        <label>
            <span>Kategori</span>
            <select asp-for="CategoryId">
                <option value="">Velg kategori</option>
                @foreach (var category in categories)
                {
                    <option value="@category.CategoryId">@category.Navn</option>
                }
            </select>
            <span asp-validation-for="CategoryId"></span>
        </label>
        <label>
            <span>Adresse / sted</span>
            <input asp-for="Adresse" autocomplete="street-address">
            <span asp-validation-for="Adresse"></span>
        </label>
        @if (Model.Type == "behov")
        {
            <label>
                <span>Prioritet</span>
                <select asp-for="Prioritet">
                    <option value="">Velg prioritet</option>
                    <option value="høy">Høy</option>
                    <option value="middels">Middels</option>
                    <option value="lav">Lav</option>
                </select>
                <span asp-validation-for="Prioritet"></span>
            </label>
        }
        <label>
            <span>Frist</span>
            <input asp-for="Frist" type="date">
            <span asp-validation-for="Frist"></span>
        </label>
        <label>
            <span>Beskrivelse</span>
            <textarea asp-for="Beskrivelse" rows="5"></textarea>
            <span asp-validation-for="Beskrivelse"></span>
        </label>
        <div class="profile-edit-actions">
            <a asp-controller="Account" asp-action="Profile" class="profile-button">Avbryt</a>
            <button type="submit" class="profile-add">Lagre endringer</button>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
