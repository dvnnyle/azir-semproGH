@model AccountViewModel
@{
    ViewData["Title"] = "Logg inn";
}
<link rel="stylesheet" href="~/css/account.css" asp-append-version="true">

<div class="page-fill konto-wrap">
    <div class="kort">
        <div class="konto-header">
            <div class="avatar-sirkel"><i class="fa-solid fa-user"></i></div>
            <div class="tittel-blokk">
                <h1>Logg inn</h1>
                <p>Logg inn for a fa tilgang til kontoen din</p>
            </div>
        </div>

        <form class="inputs-stack" method="post" asp-controller="Account" asp-action="Login">
            <div class="felt-gruppe">
                <label class="konto-label" asp-for="Email">E-post</label>
                <input type="email" asp-for="Email" class="konto-input" placeholder="navn@eksempel.no" required>
            </div>

            <div class="felt-gruppe">
                <label class="konto-label" asp-for="Password">Passord</label>
                <input type="password" asp-for="Password" class="konto-input" placeholder="Min. 8 tegn" minlength="8" required>
            </div>

            <div class="glemt-passord-row">
                <a href="#forgot-password">Glemt passord?</a>
            </div>

            <button type="submit" class="konto-knapp">Logg inn</button>
        </form>

        <div class="bytte-row">
            Har du ikke en konto? <a asp-controller="Account" asp-action="Register">Registrer deg</a>
        </div>
    </div>
</div>