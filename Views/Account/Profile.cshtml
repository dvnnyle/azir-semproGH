@model azir_sempro.Models.AccountProfileViewModel
@{
    ViewData["Title"] = "Min side";
    var resourceCount = Model.Submissions.Count(item => item.Type == "ressurs");
    var needCount = Model.Submissions.Count(item => item.Type == "behov");
}
<link rel="stylesheet" href="~/css/account.css" asp-append-version="true">
<link rel="stylesheet" href="~/css/profile.css" asp-append-version="true">

<section class="profile-page">
    <div class="profile-kort">
        <span class="profile-kort__avatar"><i class="fa-solid fa-user" aria-hidden="true"></i></span>
        <div class="profile-kort__info">
            <strong>@Model.FirstName @Model.LastName</strong>
            <p><i class="fa-solid fa-envelope" aria-hidden="true"></i> @Model.Email</p>
            <p><i class="fa-solid fa-phone" aria-hidden="true"></i> @(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Ingen telefon registrert" : Model.PhoneNumber)</p>
        </div>
    </div>

    <header class="profile-heading">
        <div>
            <h1>Mine ressurser og behov</h1>
            <p>Her finner du det du har registrert, og utkast som ikke er publisert ennå.</p>
        </div>
        <a asp-controller="Form" asp-action="Draw" class="profile-add">
            <i class="fa-solid fa-plus" aria-hidden="true"></i> Ny
        </a>
    </header>

    @if (TempData["ProfileMessage"] is string message)
    {
        <p class="profile-notice" role="status">@message</p>
    }

    @{
        var antallKoblet = Model.Submissions.Count(item => item.Status == "tildelt");
        var erPortalBruker = User.IsInRole(azir_sempro.Data.AppRoles.Admin) || User.IsInRole(azir_sempro.Data.AppRoles.Heimevernet);
    }
    @if (antallKoblet > 0 && !erPortalBruker)
    {
        <div class="profile-kobling" role="status">
            <span class="profile-kobling__ikon"><i class="fa-solid fa-link" aria-hidden="true"></i></span>
            <div>
                <strong>@(antallKoblet == 1 ? "Din melding er koblet" : $"{antallKoblet} av meldingene dine er koblet")</strong>
                <p>Kriseledelsen tar kontakt med deg. Du finner detaljene i listen under.</p>
            </div>
        </div>
    }

    <div class="profile-summary" aria-label="Oversikt over dine meldinger">
        <div><strong>@Model.Submissions.Count</strong><span>Mine meldinger</span></div>
        <div><strong>@resourceCount</strong><span>Ressurser</span></div>
        <div><strong>@needCount</strong><span>Behov</span></div>
        <div><strong>@Model.Drafts.Count</strong><span>Utkast</span></div>
    </div>

    <section class="profile-list-section" aria-labelledby="submitted-heading">
        <div class="profile-section-heading">
            <div>
                <h2 id="submitted-heading">Dine ressurser og behov</h2>
                <p>Publiserte meldinger er synlige for andre.</p>
            </div>
            <span class="profile-count">@Model.Submissions.Count</span>
        </div>

        @if (Model.Submissions.Count == 0)
        {
            <div class="profile-empty">
                <span class="profile-empty__icon"><i class="fa-solid fa-box-open" aria-hidden="true"></i></span>
                <h3>Du har ikke registrert noe ennå</h3>
                <p>Registrer en ressurs du kan tilby, eller meld et behov.</p>
                <a asp-controller="Form" asp-action="Draw" class="profile-add">Ny</a>
            </div>
        }
        else
        {
            <div class="profile-rows">
                @foreach (var item in Model.Submissions)
                {
                    var isNeed = item.Type == "behov";
                    var statusLabel = item.Status switch
                    {
                        "vurderes" => "Til vurdering",
                        "tildelt" => "Tildelt",
                        "lost" => "Løst",
                        _ => "Ny"
                    };
                    <article class="profile-row">
                        <span class="profile-row__icon @(isNeed ? "profile-row__icon--need" : "")">
                            <i class="fa-solid @(isNeed ? "fa-triangle-exclamation" : "fa-hand-holding-heart")" aria-hidden="true"></i>
                        </span>
                        <div class="profile-row__main">
                            <h3>@item.Tittel</h3>
                            <p>@item.CategoryName · @item.Adresse</p>
                            @if (!string.IsNullOrEmpty(item.KobletTil))
                            {
                                <p class="profile-row__kobling"><i class="fa-solid fa-link" aria-hidden="true"></i> Koblet til: @item.KobletTil</p>
                            }
                            <span class="profile-tag @(isNeed ? "profile-tag--need" : "")">@(isNeed ? "Behov" : "Ressurs")</span>
                        </div>
                        <div class="profile-row__state">
                            <span class="profile-status"><i class="fa-solid fa-circle" aria-hidden="true"></i> @statusLabel</span>
                            <small>Oppdatert @item.Tidspunkt.ToString("dd.MM.yyyy")</small>
                        </div>
                        <div class="profile-row__actions">
                            <a asp-controller="Resources" asp-action="Index" asp-route-apne="@item.SubmissionId" class="profile-button">Åpne</a>
                            <a asp-controller="Account" asp-action="EditSubmission" asp-route-id="@item.SubmissionId" class="profile-button profile-button--edit">
                                <i class="fa-solid fa-pen" aria-hidden="true"></i> Rediger
                            </a>
                            <form asp-controller="Account" asp-action="DeleteSubmission" asp-route-id="@item.SubmissionId"
                                  method="post" class="profile-delete-form"
                                  data-confirm-delete="Er du sikker på at du vil slette «@item.Tittel»?">
                                <button type="submit" class="profile-button profile-button--delete" aria-label="Slett @item.Tittel">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i> Slett
                                </button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <section class="profile-list-section" aria-labelledby="drafts-heading">
        <div class="profile-section-heading">
            <div>
                <h2 id="drafts-heading">Utkast</h2>
                <p>Utkastene lagres på kontoen din og er bare synlige for deg.</p>
            </div>
            <span class="profile-count">@Model.Drafts.Count</span>
        </div>

        @if (Model.Drafts.Count == 0)
        {
            <div class="profile-empty profile-empty--compact">
                <p>Du har ingen påbegynte utkast.</p>
            </div>
        }
        else
        {
            <div class="profile-rows">
                @foreach (var draft in Model.Drafts)
                {
                    var isNeed = draft.Type == "behov";
                    <article class="profile-row profile-row--draft">
                        <span class="profile-row__icon profile-row__icon--draft">
                            <i class="fa-solid fa-box" aria-hidden="true"></i>
                        </span>
                        <div class="profile-row__main">
                            <h3>@(string.IsNullOrWhiteSpace(draft.Tittel) ? "Uten tittel" : draft.Tittel)</h3>
                            <p>Fortsett der du slapp, og send inn når meldingen er klar.</p>
                            <span class="profile-tag @(isNeed ? "profile-tag--need" : "")">@(isNeed ? "Behov" : "Ressurs")</span>
                        </div>
                        <div class="profile-row__state">
                            <span class="profile-status profile-status--draft"><i class="fa-solid fa-circle" aria-hidden="true"></i> Utkast</span>
                            <small>Sist lagret @draft.UpdatedAt.ToString("dd.MM.yyyy")</small>
                        </div>
                        <div class="profile-row__actions">
                            <a asp-controller="Form" asp-action="Draw" asp-route-draftId="@draft.DraftId" class="profile-button profile-button--edit">
                                <i class="fa-solid fa-pen" aria-hidden="true"></i> Fortsett utkast
                            </a>
                            <form asp-controller="Account" asp-action="DeleteDraft" asp-route-id="@draft.DraftId"
                                  method="post" class="profile-delete-form"
                                  data-confirm-delete="Er du sikker på at du vil slette dette utkastet?">
                                <button type="submit" class="profile-button profile-button--delete" aria-label="Slett utkast">
                                    <i class="fa-solid fa-trash" aria-hidden="true"></i> Slett
                                </button>
                            </form>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <aside class="profile-tip">
        <i class="fa-solid fa-hand-holding-heart" aria-hidden="true"></i>
        <div>
            <strong>Hold ressursene dine oppdatert</strong>
            <p>Oppdater meldingen under «Rediger» når en ressurs ikke lenger er tilgjengelig.</p>
        </div>
        <a asp-controller="Resources" asp-action="Index">Gå til delinger <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></a>
    </aside>
    <p class="profile-footnote">Krisis viser meldinger du har registrert. Tilgjengelighet er ikke verifisert.</p>

    <aside class="profile-danger-zone">
        <div>
            <strong>Slett konto</strong>
            <p>Sletter kontoen din og alle meldinger og utkast du har registrert.</p>
        </div>
        <a asp-controller="Account" asp-action="DeleteAccount" class="profile-button profile-button--delete">
            <i class="fa-solid fa-user-xmark" aria-hidden="true"></i> Slett konto
        </a>
    </aside>
</section>

@section Scripts {
    <script src="~/js/confirm-delete.js" asp-append-version="true"></script>
}
